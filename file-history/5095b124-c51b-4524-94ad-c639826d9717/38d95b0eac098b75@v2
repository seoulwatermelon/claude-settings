```tsx
'use client';

import React, { useState, useEffect, useCallback } from 'react';
import AdminDashboard from '@/components/AdminDashboard';
import TOHaejungTable from '@/components/TOHaejungTable';
import TOHaejungUpload from '@/components/TOHaejungUpload';
import type { ToHaejungRow } from '@/lib/types';

type Tab = 'submissions' | 'to-haejung';

export default function AdminPage() {
  const [tab, setTab] = useState<Tab>('submissions');
  const [rows, setRows] = useState<ToHaejungRow[]>([]);
  const [loading, setLoading] = useState(false);
  const [loadError, setLoadError] = useState<string | null>(null);

  const loadRows = useCallback(async () => {
    setLoading(true);
    setLoadError(null);
    try {
      const res = await fetch('/api/to-haejung');
      if (!res.ok) throw new Error(`서버 오류 (${res.status})`);
      setRows(await res.json());
    } catch (err) {
      setLoadError(err instanceof Error ? err.message : '데이터 로드 실패');
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    if (tab === 'to-haejung') loadRows();
  }, [tab, loadRows]);

  const handleSave = async (id: number, fields: Record<string, string>) => {
    const res = await fetch(`/api/to-haejung/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(fields),
    });
    if (!res.ok) {
      const data = await res.json();
      throw new Error(data.error ?? '저장 실패');
    }
    setRows((prev) => prev.map((r) => (r.id === id ? { ...r, ...fields } : r)));
  };

  return (
    <div>
      <div className="mb-6">
        <h1 className="text-2xl font-bold text-gray-900">관리자 대시보드</h1>
      </div>

      {/* 탭 */}
      <div className="flex border-b border-gray-200 mb-6">
        <button
          type="button"
          onClick={() => setTab('submissions')}
          className={`px-5 py-2.5 text-sm font-medium -mb-px border-b-2 transition-colors ${
            tab === 'submissions'
              ? 'border-blue-700 text-blue-700'
              : 'border-transparent text-gray-500 hover:text-gray-700'
          }`}
        >
          제출 현황
        </button>
        <button
          type="button"
          onClick={() => setTab('to-haejung')}
          className={`px-5 py-2.5 text-sm font-medium -mb-px border-b-2 transition-colors ${
            tab === 'to-haejung'
              ? 'border-blue-700 text-blue-700'
              : 'border-transparent text-gray-500 hover:text-gray-700'
          }`}
        >
          TO 배정 관리
        </button>
      </div>

      {tab === 'submissions' && <AdminDashboard />}

      {tab === 'to-haejung' && (
        <div className="space-y-6">
          {/* 업로드 섹션 */}
          <div className="bg-white rounded-lg shadow p-5">
            <h2 className="text-base font-semibold text-gray-800 mb-3">Excel 업로드</h2>
            <p className="text-xs text-gray-500 mb-3">
              RAW 데이터 형식(.xlsx)을 업로드하면 기존 TO 배정 데이터가 전체 교체됩니다.
            </p>
            <TOHaejungUpload onSuccess={loadRows} />
          </div>

          {/* 테이블 섹션 */}
          <div className="bg-white rounded-lg shadow p-5">
            <div className="flex items-center justify-between mb-3">
              <h2 className="text-base font-semibold text-gray-800">TO 배정 현황 (편집 가능)</h2>
              <p className="text-xs text-gray-400">셀을 더블클릭하면 편집할 수 있습니다</p>
            </div>
            {loading ? (
              <div className="py-8 text-center text-gray-400 text-sm">로딩 중...</div>
            ) : loadError ? (
              <div className="rounded bg-red-50 border border-red-200 p-4 text-sm text-red-700">
                {loadError}
              </div>
            ) : (
              <TOHaejungTable rows={rows} editable onSave={handleSave} />
            )}
          </div>
        </div>
      )}
    </div>
  );
}
```

