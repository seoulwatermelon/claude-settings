'use client';

import React, { useRef, useState } from 'react';

interface Props {
  onSuccess: () => void;
}

export default function TOHaejungUpload({ onSuccess }: Props) {
  const fileRef = useRef<HTMLInputElement>(null);
  const [status, setStatus] = useState<{ type: 'success' | 'error'; message: string } | null>(null);
  const [uploading, setUploading] = useState(false);

  const handleUpload = async () => {
    const file = fileRef.current?.files?.[0];
    if (!file) {
      setStatus({ type: 'error', message: '파일을 선택해주세요.' });
      return;
    }
    if (!file.name.endsWith('.xlsx')) {
      setStatus({ type: 'error', message: '.xlsx 파일만 업로드 가능합니다.' });
      return;
    }
    const confirmed = window.confirm('기존 데이터가 모두 교체됩니다. 계속하시겠습니까?');
    if (!confirmed) return;

    setUploading(true);
    setStatus(null);
    const formData = new FormData();
    formData.append('file', file);
    try {
      const res = await fetch('/api/to-haejung/upload', { method: 'POST', body: formData });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error ?? '업로드 실패');
      setStatus({ type: 'success', message: `${data.count}개 행이 성공적으로 임포트되었습니다.` });
      if (fileRef.current) fileRef.current.value = '';
      onSuccess();
    } catch (err) {
      setStatus({ type: 'error', message: err instanceof Error ? err.message : '업로드 실패' });
    } finally {
      setUploading(false);
    }
  };

  return (
    <div className="space-y-3">
      <div className="flex items-center gap-3">
        <input
          ref={fileRef}
          type="file"
          accept=".xlsx"
          className="block text-sm text-gray-600 file:mr-3 file:py-2 file:px-4 file:rounded file:border-0 file:bg-blue-50 file:text-blue-700 file:cursor-pointer hover:file:bg-blue-100"
        />
        <button
          type="button"
          onClick={handleUpload}
          disabled={uploading}
          className="px-4 py-2 bg-blue-700 text-white text-sm rounded hover:bg-blue-800 disabled:opacity-50"
        >
          {uploading ? '업로드 중...' : '업로드'}
        </button>
      </div>
      {status && (
        <div
          className={`rounded p-3 text-sm ${
            status.type === 'success'
              ? 'bg-green-50 border border-green-200 text-green-800'
              : 'bg-red-50 border border-red-200 text-red-700'
          }`}
        >
          {status.message}
        </div>
      )}
    </div>
  );
}
