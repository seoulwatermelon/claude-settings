import { NextRequest, NextResponse } from 'next/server';
import getDb from '@/lib/db';

// 화이트리스트: SQL 인젝션 방지
const ALLOWED_FIELDS = new Set([
  'college', 'department', 'confirm_rate_26', 'faculty_count_26',
  'new_hires', 'retirees', 'upcoming_retirements',
  'req_general', 'req_dedicated', 'req_external', 'req_total',
  'invitation_field', 'request_reason',
  'to_general', 'to_dedicated', 'to_external', 'to_total',
  'adv_general', 'adv_dedicated', 'adv_external', 'adv_total',
  'pres_general', 'pres_dedicated', 'pres_external', 'pres_total',
  'assign_reason', 'hq_opinion', 'bigs',
  'to_req_25', 'to_assign_25',
  'hire_regular_25', 'hire_rolling_25', 'hire_total_25',
  'note', 'remark',
]);

export async function PATCH(
  req: NextRequest,
  { params }: { params: { id: string } }
): Promise<NextResponse> {
  const id = Number(params.id);
  if (!Number.isInteger(id) || id <= 0) {
    return NextResponse.json({ error: '잘못된 ID' }, { status: 400 });
  }

  let body: Record<string, unknown>;
  try {
    body = await req.json();
  } catch {
    return NextResponse.json({ error: '요청 파싱 실패' }, { status: 400 });
  }

  const entries = Object.entries(body);
  if (entries.length === 0) {
    return NextResponse.json({ error: '수정할 필드가 없습니다' }, { status: 400 });
  }

  // 화이트리스트 검증
  for (const [field] of entries) {
    if (!ALLOWED_FIELDS.has(field)) {
      return NextResponse.json({ error: `허용되지 않는 필드: ${field}` }, { status: 400 });
    }
  }

  const setClauses = entries.map(([field]) => `${field} = ?`).join(', ');
  const values = entries.map(([, val]) => (val === undefined ? null : String(val)));

  try {
    const db = getDb();
    const result = db
      .prepare(`UPDATE to_haejung SET ${setClauses}, updated_at = datetime('now') WHERE id = ?`)
      .run([...values, id]);

    if (result.changes === 0) {
      return NextResponse.json({ error: '해당 ID가 없습니다' }, { status: 404 });
    }
    return NextResponse.json({ ok: true });
  } catch (err) {
    return NextResponse.json(
      { error: err instanceof Error ? err.message : '수정 실패' },
      { status: 500 }
    );
  }
}
