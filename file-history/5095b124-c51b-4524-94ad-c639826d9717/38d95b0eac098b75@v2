'use client';

import React, { useState } from 'react';
import type { ToHaejungRow } from '@/lib/types';

interface Props {
  rows: ToHaejungRow[];
  editable?: boolean;
  onSave?: (id: number, fields: Record<string, string>) => Promise<void>;
}

// 긴 텍스트 컬럼 목록
const LONG_TEXT_COLS = new Set([
  'invitation_field', 'request_reason', 'assign_reason', 'hq_opinion', 'note', 'remark',
]);

// 편집 가능한 셀 컴포넌트 (TOHaejungTable 밖에 module-level로 정의 — hooks 안정성 보장)
function EditableCell({
  rowId,
  field,
  value,
  onSave,
}: {
  rowId: number;
  field: string;
  value: string | null;
  onSave?: (id: number, fields: Record<string, string>) => Promise<void>;
}) {
  const [editing, setEditing] = useState(false);
  const [draft, setDraft] = useState(value ?? '');
  const [dirty, setDirty] = useState(false);  // 변경됐지만 아직 저장 전
  const [saving, setSaving] = useState(false);
  const [saved, setSaved] = useState(false);
  const isLong = LONG_TEXT_COLS.has(field);

  const commit = async () => {
    if (!dirty || !onSave) {
      setEditing(false);
      setDirty(false);
      return;
    }
    setSaving(true);
    await onSave(rowId, { [field]: draft });
    setSaving(false);
    setDirty(false);
    setSaved(true);
    setEditing(false);
    setTimeout(() => setSaved(false), 500);
  };

  if (editing) {
    const commonProps = {
      value: draft,
      onChange: (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
        setDraft(e.target.value);
        setDirty(e.target.value !== (value ?? ''));
      },
      onBlur: commit,
      autoFocus: true,
      className: 'w-full border border-blue-400 rounded px-1 text-xs bg-yellow-50',
    };
    return isLong ? (
      <textarea
        {...commonProps}
        onKeyDown={(e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); commit(); } }}
        rows={3}
      />
    ) : (
      <input
        {...commonProps}
        onKeyDown={(e) => { if (e.key === 'Enter') commit(); }}
        type="text"
      />
    );
  }

  const displayVal = value ?? '';
  // 저장 전 변경된 셀: 노란 배경 / 저장 완료: 초록 배경
  const bgClass = saved ? 'bg-green-100' : dirty ? 'bg-yellow-100' : '';

  return (
    <div
      onDoubleClick={() => { setEditing(true); setDraft(value ?? ''); setDirty(false); }}
      className={`cursor-default select-none ${bgClass} ${saving ? 'opacity-50' : ''} ${
        isLong ? 'max-w-[160px] truncate overflow-hidden' : ''
      }`}
      title={isLong ? displayVal : undefined}
    >
      {displayVal || <span className="text-gray-300">—</span>}
    </div>
  );
}

// 읽기 전용 셀
function ReadCell({ value, field }: { value: string | null; field: string }) {
  const isLong = LONG_TEXT_COLS.has(field);
  const displayVal = value ?? '';
  return (
    <div
      className={isLong ? 'max-w-[160px] truncate overflow-hidden' : ''}
      title={isLong ? displayVal : undefined}
    >
      {displayVal || <span className="text-gray-300">—</span>}
    </div>
  );
}

