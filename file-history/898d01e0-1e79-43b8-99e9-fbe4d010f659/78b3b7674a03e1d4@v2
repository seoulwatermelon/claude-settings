def make_schedule_table():
    col_w = [10000, 15000, 17520]
    row_h = 1900
    rows_data = [
        # (구분, 일정, 비고, is_header)
        ('구분', '일정', '비고', True),
        ('철거 및 이전 공지', "'26.3月 중", '전략기획팀, 교원인사팀, 관리팀, 소속행정실', False),
        ('임시공간 배정 및\n연구실 이전', "'26.6月 중\n(학기종료 직후)", '-', False),
        ('교수회관 철거', "'26.7月 ~ 8月", '-', False),
    ]

    total_w = sum(col_w)
    total_h = row_h * len(rows_data)
    tbl = make_table(nid(), len(rows_data), 3, total_w, total_h, borderFillID=5)

    for ri, (c0, c1, c2, is_hdr) in enumerate(rows_data):
        tr = etree.SubElement(tbl, f'{{{HP}}}tr')
        bf = 7 if is_hdr else 5
        charP = 2 if is_hdr else 0
        for ci, (txt, cw) in enumerate(zip([c0, c1, c2], col_w)):
            tc = make_cell(ci, ri, 1, 1, cw, row_h, bf, 'CENTER', 21, charP, txt)
            tr.append(tc)

    return tbl

