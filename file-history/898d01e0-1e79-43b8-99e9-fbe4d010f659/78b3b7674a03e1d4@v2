        ('중앙학술정보관\n(임시)', '5층', '22개', '31.6~38.9㎡', '전실 창문 有\n(14개실 개폐불가)', False),
        ('합계', '-', '94개', '-', '-', False),
    ]

    total_h = row_h * len(rows_data)
    tbl = make_table(nid(), len(rows_data), 5, total_w, total_h, borderFillID=5)

    for ri, row_d in enumerate(rows_data):
        tr = etree.SubElement(tbl, f'{{{HP}}}tr')
        is_hdr = row_d[5]
        bf = 7 if is_hdr else 5
        charP = 2 if is_hdr else 0
