# 결재란 폭 = 42520 (본문폭 기준)
# 열 배분: 4열 균등 → 10630 * 4 = 42520
# ─────────────────────────────────────────────────────
def make_approval_table():
    """결재란 표 (2행 4열)"""
    col_w = 10630  # 4열 균등
    row1_h = 1700  # 직책 행
    row2_h = 3200  # 서명 행
    total_h = row1_h + row2_h
    total_w = col_w * 4

    tbl = make_table(nid(), 2, 4, total_w, total_h, borderFillID=5)

    headers = ['담당', '팀장', '인사처장', '서명']
    for ci, hdr in enumerate(headers):
        bf = 7 if ci < 3 else 7  # 헤더 셀은 #F2F2F2 배경
        tc = make_cell(ci, 0, 1, 1, col_w, row1_h, bf, 'CENTER', 21, 2, hdr)
        tr = tbl.find(f'{{{HP}}}tr') if tbl.find(f'{{{HP}}}tr') is not None else None
        if tr is None:
            tr = etree.SubElement(tbl, f'{{{HP}}}tr')
        tr.append(tc)

    tr2 = etree.SubElement(tbl, f'{{{HP}}}tr')
    sign_texts = ['승주완', '', '', '']
    for ci, txt in enumerate(sign_texts):
        tc = make_cell(ci, 1, 1, 1, col_w, row2_h, 5, 'CENTER', 21, 0, txt)
        tr2.append(tc)

    return tbl

