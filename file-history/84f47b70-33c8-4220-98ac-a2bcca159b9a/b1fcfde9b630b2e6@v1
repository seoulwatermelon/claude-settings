import { NextRequest } from 'next/server';

// Mock better-sqlite3
jest.mock('better-sqlite3', () => {
  const mockRun = jest.fn().mockReturnValue({ lastInsertRowid: 1 });
  const mockAll = jest.fn().mockReturnValue([]);
  const mockGet = jest.fn().mockReturnValue(undefined);
  const mockPrepare = jest.fn().mockReturnValue({ run: mockRun, all: mockAll, get: mockGet });
  const mockTransaction = jest.fn().mockImplementation((fn: () => unknown) => fn);
  const mockExec = jest.fn();
  const mockPragma = jest.fn();
  const MockDB = jest.fn().mockImplementation(() => ({
    prepare: mockPrepare,
    transaction: mockTransaction,
    exec: mockExec,
    pragma: mockPragma,
  }));
  return MockDB;
});

// Mock fs
jest.mock('fs', () => ({
  existsSync: jest.fn().mockReturnValue(true),
  mkdirSync: jest.fn(),
  readFileSync: jest.fn().mockReturnValue(''),
}));

import { POST, GET } from '@/app/api/submissions/route';

function makeRequest(body: unknown, url = 'http://localhost/api/submissions'): NextRequest {
  return new NextRequest(url, {
    method: body ? 'POST' : 'GET',
    headers: { 'Content-Type': 'application/json' },
    body: body ? JSON.stringify(body) : undefined,
  });
}

describe('POST /api/submissions', () => {
  const validBody = {
    department_name: '소프트웨어학과',
    dean_name: '홍길동',
    submitted_at: '2024-03-15',
    candidates: [{ name: '김테스트', birth_year: 1990 }],
    hiringProgress: [],
  };

  it('정상 데이터 제출 시 201 응답', async () => {
    const req = makeRequest(validBody);
    const res = await POST(req);
    expect(res.status).toBe(201);
    const json = await res.json();
    expect(json).toHaveProperty('id');
    expect(json).toHaveProperty('message');
  });

  it('필수 필드(department_name) 누락 시 400 에러', async () => {
    const req = makeRequest({ dean_name: '홍길동', submitted_at: '2024-03-15', candidates: [] });
    const res = await POST(req);
    expect(res.status).toBe(400);
    const json = await res.json();
    expect(json).toHaveProperty('error');
  });

  it('필수 필드(dean_name) 누락 시 400 에러', async () => {
    const req = makeRequest({ department_name: '소프트웨어학과', submitted_at: '2024-03-15', candidates: [] });
    const res = await POST(req);
    expect(res.status).toBe(400);
  });

  it('필수 필드(submitted_at) 누락 시 400 에러', async () => {
    const req = makeRequest({ department_name: '소프트웨어학과', dean_name: '홍길동', candidates: [] });
    const res = await POST(req);
    expect(res.status).toBe(400);
  });

  it('candidates가 없는 제출도 200 처리 (빈 배열)', async () => {
    const req = makeRequest({ ...validBody, candidates: [] });
    const res = await POST(req);
    expect(res.status).toBe(201);
  });

  it('잘못된 JSON 형식 → 400 에러', async () => {
    const req = new NextRequest('http://localhost/api/submissions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: 'not-json',
    });
    const res = await POST(req);
    expect(res.status).toBe(400);
  });
});

describe('GET /api/submissions', () => {
  it('목록 조회 → 배열 응답', async () => {
    const req = new NextRequest('http://localhost/api/submissions');
    const res = await GET(req);
    expect(res.status).toBe(200);
    const json = await res.json();
    expect(Array.isArray(json)).toBe(true);
  });

  it('?format=excel → Content-Type이 엑셀 형식', async () => {
    const req = new NextRequest('http://localhost/api/submissions?format=excel');
    const res = await GET(req);
    expect(res.status).toBe(200);
    expect(res.headers.get('Content-Type')).toContain('application/vnd.openxmlformats');
  });
});
