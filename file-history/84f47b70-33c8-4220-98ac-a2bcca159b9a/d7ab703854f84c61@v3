import { NextRequest, NextResponse } from 'next/server';
import getDb from '@/lib/db';
import type {
  SubmissionDetail,
  SubmissionRow,
  CandidateDbRow,
  DegreeDbRow,
  CareerDbRow,
  ProgressDbRow,
} from '@/lib/types';

interface Params {
  params: { id: string };
}

export async function GET(_request: NextRequest, { params }: Params) {
  const db = getDb();
  const id = parseInt(params.id, 10);

  if (isNaN(id)) {
    return NextResponse.json({ error: '유효하지 않은 ID입니다.' }, { status: 400 });
  }

  try {
    const submission = db
      .prepare(`SELECT * FROM submissions WHERE id = ?`)
      .get(id) as SubmissionRow | undefined;

    if (!submission) {
      return NextResponse.json({ error: '해당 제출 데이터를 찾을 수 없습니다.' }, { status: 404 });
    }

    const candidateRows = db
      .prepare(`SELECT * FROM candidates WHERE submission_id = ? ORDER BY id`)
      .all(id) as CandidateDbRow[];

    let candidates: SubmissionDetail['candidates'] = [];

    if (candidateRows.length > 0) {
      const candidateIds = candidateRows.map((c) => c.id);
      const inClause = candidateIds.map(() => '?').join(',');

      const allDegrees = db
        .prepare(`SELECT * FROM candidate_degrees WHERE candidate_id IN (${inClause}) ORDER BY candidate_id, id`)
        .all(...candidateIds) as DegreeDbRow[];

      const allCareers = db
        .prepare(`SELECT * FROM candidate_careers WHERE candidate_id IN (${inClause}) ORDER BY candidate_id, id`)
        .all(...candidateIds) as CareerDbRow[];

      const degreesByCandidate = new Map<number, DegreeDbRow[]>();
      const careersByCandidate = new Map<number, CareerDbRow[]>();

      for (const d of allDegrees) {
        const list = degreesByCandidate.get(d.candidate_id) ?? [];
        list.push(d);
        degreesByCandidate.set(d.candidate_id, list);
      }
      for (const ca of allCareers) {
        const list = careersByCandidate.get(ca.candidate_id) ?? [];
        list.push(ca);
        careersByCandidate.set(ca.candidate_id, list);
      }

      candidates = candidateRows.map((c) => ({
        id: c.id,
        name: c.name,
        birth_year: c.birth_year,
        current_affiliation: c.current_affiliation,
        current_position: c.current_position,
        major_field: c.major_field,
        total_papers: c.total_papers,
        jcr_ratio: c.jcr_ratio,
        fwci: c.fwci,
        remarks: c.remarks,
        degrees: (degreesByCandidate.get(c.id) ?? []).map((d) => ({
          school: d.school,
          major: d.major,
          degree_year: d.degree_year,
          degree_type: d.degree_type,
        })),
        careers: (careersByCandidate.get(c.id) ?? []).map((ca) => ({
          institution: ca.institution,
          position: ca.position,
          period: ca.period,
        })),
      }));
    }

    const hiringProgress = (
      db
        .prepare(`SELECT * FROM hiring_progress WHERE submission_id = ? ORDER BY id`)
        .all(id) as ProgressDbRow[]
    ).map((p) => ({
      progress_date: p.progress_date,
      content: p.content,
      person_in_charge: p.person_in_charge,
    }));

    const detail: SubmissionDetail = {
      ...submission,
      candidates,
      hiringProgress,
    };

    return NextResponse.json(detail);
  } catch (error) {
    console.error(`GET /api/submissions/${id} error:`, error);
    return NextResponse.json(
      { error: '서버 오류가 발생했습니다.' },
      { status: 500 }
    );
  }
}
