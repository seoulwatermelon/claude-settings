'use client';

import React, { useState } from 'react';
import DynamicTable, { ColumnDef } from './DynamicTable';

export interface DegreeRow {
  _id: string;
  school: string;
  major: string;
  degree_year: string;
  degree_type: string;
}

export interface CareerRow {
  _id: string;
  institution: string;
  position: string;
  period: string;
}

export interface CandidateRow {
  _id: string;
  name: string;
  birth_year: string;
  current_affiliation: string;
  current_position: string;
  major_field: string;
  total_papers: string;
  jcr_ratio: string;
  fwci: string;
  remarks: string;
  degrees: DegreeRow[];
  careers: CareerRow[];
}

interface CandidateFormProps {
  candidates: CandidateRow[];
  onCandidatesChange: (candidates: CandidateRow[]) => void;
}

const generateId = () => Math.random().toString(36).substr(2, 9);

const candidateColumns: ColumnDef<Omit<CandidateRow, 'degrees' | 'careers'> & { _id: string }>[] = [
  { key: 'name', label: '성명', type: 'text', width: '80px' },
  { key: 'birth_year', label: '출생년도', type: 'text', width: '80px' },
  { key: 'current_affiliation', label: '현소속', type: 'text' },
  { key: 'current_position', label: '직위', type: 'text', width: '100px' },
  { key: 'major_field', label: '전공분야', type: 'text' },
  { key: 'total_papers', label: '논문수(총)', type: 'number', width: '80px' },
  { key: 'jcr_ratio', label: 'JCR상위(%)', type: 'number', width: '90px' },
  { key: 'fwci', label: 'FWCI', type: 'number', width: '70px' },
  { key: 'remarks', label: '비고', type: 'text' },
];

const degreeColumns: ColumnDef<DegreeRow>[] = [
  { key: 'school', label: '학교명', type: 'text' },
  { key: 'major', label: '전공', type: 'text' },
  { key: 'degree_year', label: '취득년도', type: 'text', width: '90px' },
  { key: 'degree_type', label: '학위구분', type: 'text', width: '90px' },
];

const careerColumns: ColumnDef<CareerRow>[] = [
  { key: 'institution', label: '기관명', type: 'text' },
  { key: 'position', label: '직위', type: 'text' },
  { key: 'period', label: '기간', type: 'text' },
];

export default function CandidateForm({
  candidates,
  onCandidatesChange,
}: CandidateFormProps) {
  const [expandedIds, setExpandedIds] = useState<Set<string>>(new Set());

  const toggleExpanded = (id: string) => {
    setExpandedIds((prev) => {
      const next = new Set(prev);
      next.has(id) ? next.delete(id) : next.add(id);
      return next;
    });
  };

  const addCandidate = () => {
    const newCandidate: CandidateRow = {
      _id: generateId(),
      name: '',
      birth_year: '',
      current_affiliation: '',
      current_position: '',
      major_field: '',
      total_papers: '',
      jcr_ratio: '',
      fwci: '',
      remarks: '',
      degrees: [],
      careers: [],
    };
    onCandidatesChange([...candidates, newCandidate]);
  };

  const deleteCandidate = (id: string) => {
    onCandidatesChange(candidates.filter((c) => c._id !== id));
    setExpandedIds((prev) => {
      const next = new Set(prev);
      next.delete(id);
      return next;
    });
  };

  const updateCandidate = (id: string, key: keyof CandidateRow, value: string) => {
    onCandidatesChange(
      candidates.map((c) => (c._id === id ? { ...c, [key]: value } : c))
    );
  };

  const updateCandidateNested = (id: string, updater: (c: CandidateRow) => CandidateRow) => {
    onCandidatesChange(candidates.map((c) => (c._id === id ? updater(c) : c)));
  };

  // Degree handlers
  const addDegree = (candidateId: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      degrees: [
        ...c.degrees,
        { _id: generateId(), school: '', major: '', degree_year: '', degree_type: '' },
      ],
    }));
  };

  const deleteDegree = (candidateId: string, degreeId: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      degrees: c.degrees.filter((d) => d._id !== degreeId),
    }));
  };

  const updateDegree = (candidateId: string, degreeId: string, key: keyof DegreeRow, value: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      degrees: c.degrees.map((d) => (d._id === degreeId ? { ...d, [key]: value } : d)),
    }));
  };

  // Career handlers
  const addCareer = (candidateId: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      careers: [
        ...c.careers,
        { _id: generateId(), institution: '', position: '', period: '' },
      ],
    }));
  };

  const deleteCareer = (candidateId: string, careerId: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      careers: c.careers.filter((ca) => ca._id !== careerId),
    }));
  };

  const updateCareer = (candidateId: string, careerId: string, key: keyof CareerRow, value: string) => {
    updateCandidateNested(candidateId, (c) => ({
      ...c,
      careers: c.careers.map((ca) => (ca._id === careerId ? { ...ca, [key]: value } : ca)),
    }));
  };

  return (
    <div className="space-y-6">
      {/* 후보자 심사요청서 테이블 */}
      <div className="section-card">
        <h2 className="section-title">후보자 심사요청서</h2>
        <DynamicTable
          columns={candidateColumns as ColumnDef<CandidateRow>[]}
          rows={candidates}
          onAddRow={addCandidate}
          onDeleteRow={deleteCandidate}
          onUpdateRow={(id, key, value) => updateCandidate(id, key as keyof CandidateRow, value)}
          addLabel="+ 후보자 추가"
          emptyMessage="후보자가 없습니다. 후보자를 추가해주세요."
        />
      </div>

      {/* 학위 및 경력 사항 섹션 */}
      {candidates.length > 0 && (
        <div className="section-card">
          <h2 className="section-title">학위 및 경력 사항</h2>
          <div className="space-y-3">
            {candidates.map((candidate, index) => {
              const isExpanded = expandedIds.has(candidate._id);
              return (
                <div key={candidate._id} className="border border-gray-200 rounded-lg overflow-hidden">
                  <button
                    type="button"
                    onClick={() => toggleExpanded(candidate._id)}
                    className="w-full flex items-center justify-between px-4 py-3 bg-gray-50 hover:bg-gray-100 transition-colors text-left"
                  >
                    <span className="font-medium text-gray-800">
                      {index + 1}. {candidate.name || `후보자 ${index + 1}`}
                      {candidate.current_affiliation && (
                        <span className="text-gray-500 font-normal ml-2 text-sm">
                          ({candidate.current_affiliation}{candidate.current_position ? ` / ${candidate.current_position}` : ''})
                        </span>
                      )}
                    </span>
                    <span className="text-gray-400">{isExpanded ? '▲' : '▼'}</span>
                  </button>

                  {isExpanded && (
                    <div className="p-4 space-y-5 bg-white">
                      <div>
                        <h3 className="text-sm font-semibold text-gray-700 mb-2">최종학위</h3>
                        <DynamicTable
                          columns={degreeColumns}
                          rows={candidate.degrees}
                          onAddRow={() => addDegree(candidate._id)}
                          onDeleteRow={(id) => deleteDegree(candidate._id, id)}
                          onUpdateRow={(id, key, value) =>
                            updateDegree(candidate._id, id, key as keyof DegreeRow, value)
                          }
                          addLabel="+ 학위 추가"
                          emptyMessage="학위 정보가 없습니다."
                        />
                      </div>
                      <div>
                        <h3 className="text-sm font-semibold text-gray-700 mb-2">경력 사항</h3>
                        <DynamicTable
                          columns={careerColumns}
                          rows={candidate.careers}
                          onAddRow={() => addCareer(candidate._id)}
                          onDeleteRow={(id) => deleteCareer(candidate._id, id)}
                          onUpdateRow={(id, key, value) =>
                            updateCareer(candidate._id, id, key as keyof CareerRow, value)
                          }
                          addLabel="+ 경력 추가"
                          emptyMessage="경력 정보가 없습니다."
                        />
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
