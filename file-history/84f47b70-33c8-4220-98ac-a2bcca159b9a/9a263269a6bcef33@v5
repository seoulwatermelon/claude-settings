import { NextRequest, NextResponse } from 'next/server';
import getDb from '@/lib/db';
import type { SubmissionInput, SubmissionRow } from '@/lib/types';
import * as XLSX from 'xlsx';

export async function POST(request: NextRequest) {
  const db = getDb();
  let body: SubmissionInput;

  try {
    body = await request.json();
  } catch {
    return NextResponse.json({ error: '잘못된 요청 형식입니다.' }, { status: 400 });
  }

  const { department_name, dean_name, submitted_at, department_plan, candidates, hiringProgress } = body;

  if (!department_name || !dean_name || !submitted_at) {
    return NextResponse.json(
      { error: '필수 필드가 누락되었습니다. (department_name, dean_name, submitted_at)' },
      { status: 400 }
    );
  }

  if (!candidates || candidates.length === 0) {
    return NextResponse.json(
      { error: '최소 1명 이상의 후보자를 추가해야 합니다.' },
      { status: 400 }
    );
  }

  try {
    const insertSubmission = db.prepare(
      `INSERT INTO submissions (department_name, dean_name, submitted_at, department_plan) VALUES (?, ?, ?, ?)`
    );
    const insertCandidate = db.prepare(
      `INSERT INTO candidates (submission_id, name, birth_year, current_affiliation, current_position, major_field, total_papers, jcr_ratio, fwci, remarks)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
    );
    const insertDegree = db.prepare(
      `INSERT INTO candidate_degrees (candidate_id, school, major, degree_year, degree_type)
       VALUES (?, ?, ?, ?, ?)`
    );
    const insertCareer = db.prepare(
      `INSERT INTO candidate_careers (candidate_id, institution, position, period)
       VALUES (?, ?, ?, ?)`
    );
    const insertProgress = db.prepare(
      `INSERT INTO hiring_progress (submission_id, progress_date, content, person_in_charge)
       VALUES (?, ?, ?, ?)`
    );

    const runTransaction = db.transaction(() => {
      const submissionResult = insertSubmission.run(department_name, dean_name, submitted_at, department_plan ?? null);
      const submissionId = Number(submissionResult.lastInsertRowid);

      for (const candidate of candidates ?? []) {
        if (!candidate.name) continue;
        const candidateResult = insertCandidate.run(
          submissionId,
          candidate.name,
          candidate.birth_year ?? null,
          candidate.current_affiliation ?? null,
          candidate.current_position ?? null,
          candidate.major_field ?? null,
          candidate.total_papers ?? null,
          candidate.jcr_ratio ?? null,
          candidate.fwci ?? null,
          candidate.remarks ?? null
        );
        const candidateId = Number(candidateResult.lastInsertRowid);

        for (const degree of candidate.degrees ?? []) {
          insertDegree.run(
            candidateId,
            degree.school ?? null,
            degree.major ?? null,
            degree.degree_year ?? null,
            degree.degree_type ?? null
          );
        }

        for (const career of candidate.careers ?? []) {
          insertCareer.run(
            candidateId,
            career.institution ?? null,
            career.position ?? null,
            career.period ?? null
          );
        }
      }

      for (const progress of hiringProgress ?? []) {
        insertProgress.run(
          submissionId,
          progress.progress_date ?? null,
          progress.content ?? null,
          progress.person_in_charge ?? null
        );
      }

      return submissionId;
    });

    const id = runTransaction();

    return NextResponse.json({ id, message: '제출 완료' }, { status: 201 });
  } catch (error) {
    console.error('POST /api/submissions error:', error);
    return NextResponse.json(
      { error: '서버 오류가 발생했습니다.' },
      { status: 500 }
    );
  }
}

export async function GET(request: NextRequest) {
  const db = getDb();
  const { searchParams } = new URL(request.url);
  const format = searchParams.get('format');

  try {
    const rows = db
      .prepare(
        `SELECT s.*, COUNT(c.id) as candidate_count
         FROM submissions s
         LEFT JOIN candidates c ON c.submission_id = s.id
         GROUP BY s.id
         ORDER BY s.created_at DESC`
      )
      .all() as SubmissionRow[];

    if (format === 'excel') {
      type CandidateExcelRow = {
        id: number; submission_id: number; department_name: string;
        dean_name: string; submitted_at: string; name: string;
        birth_year?: number; current_affiliation?: string; current_position?: string;
        major_field?: string; total_papers?: number; jcr_ratio?: number;
        fwci?: number; remarks?: string;
      };
      type DegreeExcelRow = {
        candidate_id: number; candidate_name: string; department_name: string;
        school?: string; major?: string; degree_year?: number; degree_type?: string;
      };
      type CareerExcelRow = {
        candidate_id: number; candidate_name: string; department_name: string;
        institution?: string; position?: string; period?: string;
      };

      const candidateRows = db
        .prepare(
          `SELECT c.*, s.department_name, s.dean_name, s.submitted_at
           FROM candidates c
           JOIN submissions s ON s.id = c.submission_id
           ORDER BY s.id, c.id`
        )
        .all() as CandidateExcelRow[];

      const degreeRows = db
        .prepare(
          `SELECT cd.*, c.name as candidate_name, s.department_name
           FROM candidate_degrees cd
           JOIN candidates c ON c.id = cd.candidate_id
           JOIN submissions s ON s.id = c.submission_id
           ORDER BY s.id, c.id, cd.id`
        )
        .all() as DegreeExcelRow[];

      const careerRows = db
        .prepare(
          `SELECT ca.*, c.name as candidate_name, s.department_name
           FROM candidate_careers ca
           JOIN candidates c ON c.id = ca.candidate_id
           JOIN submissions s ON s.id = c.submission_id
           ORDER BY s.id, c.id, ca.id`
        )
        .all() as CareerExcelRow[];

      const wb = XLSX.utils.book_new();

      const sheet1Data = rows.map((r) => ({
        ID: r.id,
        학과명: r.department_name,
        학장명: r.dean_name,
        제출일시: r.submitted_at,
        학과발전계획: r.department_plan ?? '',
        상태: r.status,
        후보자수: r.candidate_count ?? 0,
        생성일시: r.created_at,
      }));
      const ws1 = XLSX.utils.json_to_sheet(sheet1Data);
      XLSX.utils.book_append_sheet(wb, ws1, '제출목록');

      const sheet2Data = candidateRows.map((c) => ({
        후보자ID: c.id,
        제출ID: c.submission_id,
        학과명: c.department_name,
        학장명: c.dean_name,
        제출일시: c.submitted_at,
        이름: c.name,
        출생연도: c.birth_year,
        현소속: c.current_affiliation,
        현직위: c.current_position,
        전공분야: c.major_field,
        총논문수: c.total_papers,
        JCR비율: c.jcr_ratio,
        FWCI: c.fwci,
        비고: c.remarks,
      }));
      const ws2 = XLSX.utils.json_to_sheet(sheet2Data);
      XLSX.utils.book_append_sheet(wb, ws2, '후보자목록');

      const sheet3Data = degreeRows.map((d) => ({
        학과명: d.department_name,
        후보자명: d.candidate_name,
        학교명: d.school,
        전공: d.major,
        취득년도: d.degree_year,
        학위구분: d.degree_type,
      }));
      const ws3 = XLSX.utils.json_to_sheet(sheet3Data);
      XLSX.utils.book_append_sheet(wb, ws3, '학위목록');

      const sheet4Data = careerRows.map((ca) => ({
        학과명: ca.department_name,
        후보자명: ca.candidate_name,
        기관명: ca.institution,
        직위: ca.position,
        기간: ca.period,
      }));
      const ws4 = XLSX.utils.json_to_sheet(sheet4Data);
      XLSX.utils.book_append_sheet(wb, ws4, '경력목록');

      const buffer = XLSX.write(wb, { type: 'buffer', bookType: 'xlsx' });

      return new NextResponse(buffer, {
        status: 200,
        headers: {
          'Content-Type':
            'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'Content-Disposition': 'attachment; filename="submissions.xlsx"',
        },
      });
    }

    return NextResponse.json(rows);
  } catch (error) {
    console.error('GET /api/submissions error:', error);
    return NextResponse.json(
      { error: '서버 오류가 발생했습니다.' },
      { status: 500 }
    );
  }
}
