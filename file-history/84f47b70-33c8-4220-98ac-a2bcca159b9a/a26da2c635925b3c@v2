'use client';

import React, { useState, useEffect } from 'react';
import type { SubmissionRow, SubmissionDetail } from '@/lib/types';

const DEPARTMENTS = [
  '전체',
  '반도체시스템공학과',
  '전자전기공학부',
  '소프트웨어학과',
  '화학공학생명공학부',
  '기계공학부',
  '건설환경공학부',
  '시스템경영공학과',
];

const statusLabel = (status: string) => {
  switch (status) {
    case 'submitted':
      return <span className="badge-pending">제출됨</span>;
    case 'reviewed':
      return <span className="badge-reviewed">검토 중</span>;
    case 'completed':
      return <span className="badge-completed">처리 완료</span>;
    default:
      return <span className="badge-pending">{status}</span>;
  }
};

export default function AdminDashboard() {
  const [submissions, setSubmissions] = useState<SubmissionRow[]>([]);
  const [loading, setLoading] = useState(true);
  const [loadError, setLoadError] = useState<string | null>(null);
  const [selectedDetail, setSelectedDetail] = useState<SubmissionDetail | null>(null);
  const [detailLoading, setDetailLoading] = useState(false);
  const [detailError, setDetailError] = useState<string | null>(null);
  const [filterDept, setFilterDept] = useState('전체');
  const [filterStatus, setFilterStatus] = useState('all');
  const [expandedCandidateId, setExpandedCandidateId] = useState<number | null>(null);
  const [excelLoading, setExcelLoading] = useState(false);

  useEffect(() => {
    const load = async () => {
      try {
        const res = await fetch('/api/submissions');
        if (!res.ok) throw new Error(`서버 오류 (${res.status})`);
        const data = await res.json();
        setSubmissions(data);
      } catch (err) {
        setLoadError(err instanceof Error ? err.message : '데이터를 불러오지 못했습니다.');
      } finally {
        setLoading(false);
      }
    };
    load();
  }, []);

  const openDetail = async (id: number) => {
    setDetailLoading(true);
    setSelectedDetail(null);
    setDetailError(null);
    setExpandedCandidateId(null);
    try {
      const res = await fetch(`/api/submissions/${id}`);
      if (!res.ok) throw new Error(`서버 오류 (${res.status})`);
      const data: SubmissionDetail = await res.json();
      setSelectedDetail(data);
    } catch (err) {
      setDetailError(err instanceof Error ? err.message : '상세 정보를 불러오지 못했습니다.');
    } finally {
      setDetailLoading(false);
    }
  };

  const handleExcelDownload = async () => {
    setExcelLoading(true);
    try {
      const res = await fetch('/api/submissions?format=excel');
      if (!res.ok) throw new Error('엑셀 생성 오류');
      const blob = await res.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = '교원채용현황.xlsx';
      a.click();
      URL.revokeObjectURL(url);
    } catch {
      alert('엑셀 다운로드 중 오류가 발생했습니다.');
    } finally {
      setExcelLoading(false);
    }
  };

  const filteredSubmissions = submissions.filter((s) => {
    const deptMatch = filterDept === '전체' || s.department_name === filterDept;
    const statusMatch = filterStatus === 'all' || s.status === filterStatus;
    return deptMatch && statusMatch;
  });

  const stats = {
    total: submissions.length,
    submitted: submissions.filter((s) => s.status === 'submitted').length,
    reviewed: submissions.filter((s) => s.status === 'reviewed').length,
    completed: submissions.filter((s) => s.status === 'completed').length,
  };

  if (loading) {
    return (
      <div className="flex items-center justify-center h-64">
        <div className="text-gray-500">데이터를 불러오는 중...</div>
      </div>
    );
  }

  if (loadError) {
    return (
      <div className="rounded-md bg-red-50 border border-red-200 p-6 text-center">
        <p className="text-red-700 font-medium">데이터 로드 실패</p>
        <p className="text-red-500 text-sm mt-1">{loadError}</p>
        <button
          type="button"
          onClick={() => window.location.reload()}
          className="btn-primary mt-4 text-sm"
        >
          다시 시도
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* 통계 카드 */}
      <div className="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div className="bg-white rounded-lg shadow p-5 border-l-4 border-blue-700">
          <p className="text-sm text-gray-500">총 제출 건수</p>
          <p className="text-3xl font-bold text-gray-800 mt-1">{stats.total}</p>
        </div>
        <div className="bg-white rounded-lg shadow p-5 border-l-4 border-yellow-400">
          <p className="text-sm text-gray-500">제출됨</p>
          <p className="text-3xl font-bold text-yellow-600 mt-1">{stats.submitted}</p>
        </div>
        <div className="bg-white rounded-lg shadow p-5 border-l-4 border-blue-400">
          <p className="text-sm text-gray-500">검토 중</p>
          <p className="text-3xl font-bold text-blue-600 mt-1">{stats.reviewed}</p>
        </div>
        <div className="bg-white rounded-lg shadow p-5 border-l-4 border-green-500">
          <p className="text-sm text-gray-500">처리 완료</p>
          <p className="text-3xl font-bold text-green-600 mt-1">{stats.completed}</p>
        </div>
      </div>

      {/* 필터 + 엑셀 다운로드 */}
      <div className="section-card">
        <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-4">
          <h2 className="text-lg font-semibold text-gray-800">제출 현황</h2>
          <button
            type="button"
            onClick={handleExcelDownload}
            disabled={excelLoading}
            className="btn-success flex items-center gap-2 text-sm"
          >
            {excelLoading ? '생성 중...' : '엑셀 다운로드 (전체)'}
          </button>
        </div>

        <div className="flex flex-col sm:flex-row gap-3 mb-4">
          <div>
            <label className="form-label">학과 필터</label>
            <select
              value={filterDept}
              onChange={(e) => setFilterDept(e.target.value)}
              className="form-input w-auto"
            >
              {DEPARTMENTS.map((d) => (
                <option key={d} value={d}>{d}</option>
              ))}
            </select>
          </div>
          <div>
            <label className="form-label">상태 필터</label>
            <select
              value={filterStatus}
              onChange={(e) => setFilterStatus(e.target.value)}
              className="form-input w-auto"
            >
              <option value="all">전체</option>
              <option value="submitted">제출됨</option>
              <option value="reviewed">검토 중</option>
              <option value="completed">처리 완료</option>
            </select>
          </div>
        </div>

        <div className="overflow-x-auto rounded-lg border border-gray-200">
          <table className="min-w-full divide-y divide-gray-200">
            <thead className="bg-blue-700">
              <tr>
                <th className="px-4 py-3 text-left text-xs font-semibold text-white uppercase">학과명</th>
                <th className="px-4 py-3 text-left text-xs font-semibold text-white uppercase">학장명</th>
                <th className="px-4 py-3 text-left text-xs font-semibold text-white uppercase">제출일</th>
                <th className="px-4 py-3 text-center text-xs font-semibold text-white uppercase">후보자 수</th>
                <th className="px-4 py-3 text-center text-xs font-semibold text-white uppercase">상태</th>
                <th className="px-4 py-3 text-center text-xs font-semibold text-white uppercase">상세보기</th>
              </tr>
            </thead>
            <tbody className="bg-white divide-y divide-gray-100">
              {filteredSubmissions.length === 0 ? (
                <tr>
                  <td colSpan={6} className="px-4 py-8 text-center text-gray-400">
                    해당 조건의 제출 건이 없습니다.
                  </td>
                </tr>
              ) : (
                filteredSubmissions.map((s, i) => (
                  <tr key={s.id} className={i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}>
                    <td className="px-4 py-3 text-sm text-gray-800">{s.department_name}</td>
                    <td className="px-4 py-3 text-sm text-gray-800">{s.dean_name}</td>
                    <td className="px-4 py-3 text-sm text-gray-600">{s.submitted_at}</td>
                    <td className="px-4 py-3 text-sm text-center text-gray-800">
                      {s.candidate_count ?? 0}명
                    </td>
                    <td className="px-4 py-3 text-center">{statusLabel(s.status)}</td>
                    <td className="px-4 py-3 text-center">
                      <button
                        type="button"
                        onClick={() => openDetail(s.id)}
                        className="btn-primary text-xs py-1 px-3"
                      >
                        상세보기
                      </button>
                    </td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </div>

      {/* 상세 조회 모달 */}
      {(detailLoading || selectedDetail) && (
        <div className="fixed inset-0 z-50 overflow-y-auto bg-black bg-opacity-50 flex items-start justify-center p-4 pt-10">
          <div className="bg-white rounded-xl shadow-2xl w-full max-w-4xl max-h-[90vh] overflow-y-auto">
            <div className="sticky top-0 bg-blue-700 text-white px-6 py-4 flex items-center justify-between rounded-t-xl">
              <div>
                <h2 className="text-lg font-bold">
                  {selectedDetail ? selectedDetail.department_name : '로딩 중...'} 제출 상세
                </h2>
                {selectedDetail && (
                  <p className="text-blue-200 text-sm">
                    학장: {selectedDetail.dean_name} | 제출일: {selectedDetail.submitted_at}
                  </p>
                )}
              </div>
              <button
                type="button"
                onClick={() => { setSelectedDetail(null); setExpandedCandidateId(null); }}
                className="text-white hover:text-blue-200 text-2xl font-bold"
              >
                ✕
              </button>
            </div>

            {detailLoading ? (
              <div className="flex items-center justify-center h-48">
                <p className="text-gray-500">상세 정보를 불러오는 중...</p>
              </div>
            ) : detailError ? (
              <div className="p-6">
                <div className="rounded-md bg-red-50 border border-red-200 p-4 text-center">
                  <p className="text-red-700 text-sm">{detailError}</p>
                </div>
              </div>
            ) : selectedDetail ? (
              <div className="p-6 space-y-6">
                <div className="flex items-center gap-3">
                  <span className="text-sm text-gray-600">처리 상태:</span>
                  {statusLabel(selectedDetail.status)}
                </div>

                {/* 학과 발전 계획 */}
                {selectedDetail.department_plan && (
                  <div>
                    <h3 className="text-base font-semibold text-gray-800 mb-2 pb-2 border-b">학과 발전 계획</h3>
                    <p className="text-sm text-gray-700 whitespace-pre-wrap bg-gray-50 rounded-lg p-4 border border-gray-200">
                      {selectedDetail.department_plan}
                    </p>
                  </div>
                )}

                {/* 후보자 목록 */}
                <div>
                  <h3 className="text-base font-semibold text-gray-800 mb-3 pb-2 border-b">후보자 목록</h3>
                  <div className="overflow-x-auto">
                    <table className="min-w-full text-sm divide-y divide-gray-200">
                      <thead className="bg-gray-50">
                        <tr>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">성명</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">출생년도</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">현소속/직위</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">전공분야</th>
                          <th className="px-3 py-2 text-center text-xs font-medium text-gray-600">논문수</th>
                          <th className="px-3 py-2 text-center text-xs font-medium text-gray-600">JCR(%)</th>
                          <th className="px-3 py-2 text-center text-xs font-medium text-gray-600">FWCI</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">비고</th>
                          <th className="px-3 py-2 text-center text-xs font-medium text-gray-600">학위/경력</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100">
                        {selectedDetail.candidates.map((c) => (
                          <React.Fragment key={c.id}>
                            <tr className="hover:bg-gray-50">
                              <td className="px-3 py-2 font-medium">{c.name}</td>
                              <td className="px-3 py-2">{c.birth_year}</td>
                              <td className="px-3 py-2">
                                {c.current_affiliation}
                                {c.current_position ? ` / ${c.current_position}` : ''}
                              </td>
                              <td className="px-3 py-2">{c.major_field}</td>
                              <td className="px-3 py-2 text-center">{c.total_papers}</td>
                              <td className="px-3 py-2 text-center">{c.jcr_ratio}</td>
                              <td className="px-3 py-2 text-center">{c.fwci}</td>
                              <td className="px-3 py-2 text-gray-500">{c.remarks}</td>
                              <td className="px-3 py-2 text-center">
                                <button
                                  type="button"
                                  onClick={() =>
                                    setExpandedCandidateId(
                                      expandedCandidateId === c.id ? null : c.id
                                    )
                                  }
                                  className="text-blue-600 hover:text-blue-800 text-xs underline"
                                >
                                  {expandedCandidateId === c.id ? '닫기' : '보기'}
                                </button>
                              </td>
                            </tr>
                            {expandedCandidateId === c.id && (
                              <tr>
                                <td colSpan={9} className="px-4 py-4 bg-blue-50">
                                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div>
                                      <h4 className="text-xs font-semibold text-gray-700 mb-2">최종학위</h4>
                                      {c.degrees.length === 0 ? (
                                        <p className="text-gray-400 text-xs">정보 없음</p>
                                      ) : (
                                        <table className="w-full text-xs">
                                          <thead>
                                            <tr className="text-gray-500">
                                              <th className="text-left py-1">학교명</th>
                                              <th className="text-left py-1">전공</th>
                                              <th className="text-left py-1">취득년도</th>
                                              <th className="text-left py-1">구분</th>
                                            </tr>
                                          </thead>
                                          <tbody>
                                            {c.degrees.map((d, di) => (
                                              <tr key={di}>
                                                <td className="py-0.5">{d.school}</td>
                                                <td className="py-0.5">{d.major}</td>
                                                <td className="py-0.5">{d.degree_year}</td>
                                                <td className="py-0.5">{d.degree_type}</td>
                                              </tr>
                                            ))}
                                          </tbody>
                                        </table>
                                      )}
                                    </div>
                                    <div>
                                      <h4 className="text-xs font-semibold text-gray-700 mb-2">경력</h4>
                                      {c.careers.length === 0 ? (
                                        <p className="text-gray-400 text-xs">정보 없음</p>
                                      ) : (
                                        <table className="w-full text-xs">
                                          <thead>
                                            <tr className="text-gray-500">
                                              <th className="text-left py-1">기관명</th>
                                              <th className="text-left py-1">직위</th>
                                              <th className="text-left py-1">기간</th>
                                            </tr>
                                          </thead>
                                          <tbody>
                                            {c.careers.map((ca, ci) => (
                                              <tr key={ci}>
                                                <td className="py-0.5">{ca.institution}</td>
                                                <td className="py-0.5">{ca.position}</td>
                                                <td className="py-0.5">{ca.period}</td>
                                              </tr>
                                            ))}
                                          </tbody>
                                        </table>
                                      )}
                                    </div>
                                  </div>
                                </td>
                              </tr>
                            )}
                          </React.Fragment>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

                {/* 진행 경과 */}
                <div>
                  <h3 className="text-base font-semibold text-gray-800 mb-3 pb-2 border-b">초빙 진행 경과</h3>
                  {selectedDetail.hiringProgress.length === 0 ? (
                    <p className="text-gray-400 text-sm">진행 경과가 없습니다.</p>
                  ) : (
                    <table className="w-full text-sm divide-y divide-gray-200">
                      <thead className="bg-gray-50">
                        <tr>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600 w-28">일자</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600">진행내용</th>
                          <th className="px-3 py-2 text-left text-xs font-medium text-gray-600 w-24">담당자</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-gray-100">
                        {selectedDetail.hiringProgress.map((p, i) => (
                          <tr key={i}>
                            <td className="px-3 py-2 text-gray-600">{p.progress_date}</td>
                            <td className="px-3 py-2">{p.content}</td>
                            <td className="px-3 py-2 text-gray-600">{p.person_in_charge}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </div>
              </div>
            ) : null}
          </div>
        </div>
      )}
    </div>
  );
}
