def build_new_table(college_name, rows_data):
    num_data_rows = len(rows_data)
    total_rows = 1 + num_data_rows
    total_height = 2612 + 3199 * num_data_rows

    data_rows = ""
    for i, (dept, field, count, bigo) in enumerate(rows_data):
        data_rows += make_data_row(i + 1, college_name, dept, field, count, bigo)

    return (
        f'<hp:tbl id="1766376154" zOrder="5" numberingType="TABLE" textWrap="TOP_AND_BOTTOM" '
        f'textFlow="BOTH_SIDES" lock="0" dropcapstyle="None" pageBreak="TABLE" repeatHeader="1" '
        f'rowCnt="{total_rows}" colCnt="5" cellSpacing="0" borderFillIDRef="8" noAdjust="0">'
        f'<hp:sz width="48022" widthRelTo="ABSOLUTE" height="{total_height}" heightRelTo="ABSOLUTE" protect="0"/>'
        f'<hp:pos treatAsChar="0" affectLSpacing="0" flowWithText="1" allowOverlap="0" holdAnchorAndSO="0" '
        f'vertRelTo="PARA" horzRelTo="COLUMN" vertAlign="TOP" horzAlign="LEFT" vertOffset="0" horzOffset="0"/>'
        f'<hp:outMargin left="141" right="141" top="141" bottom="141"/>'
        f'<hp:inMargin left="138" right="138" top="138" bottom="138"/>'
        f'{HEADER_ROW}{data_rows}</hp:tbl>'
    )


def create_section_xml(xml_text, college_name, recipient, rows_data):
    modified = xml_text

    # Replace 수신자 (사회과학대학장 → target)
    modified = modified.replace(
        ">사회과학대학장(사회과학대학행정실장)<",
        f">{recipient}<"
    )

    # Replace 제목 (사회과학대학 → target)
    modified = modified.replace(
        "제출 요청(사회과학대학)<",
        f"제출 요청({college_name})<"
    )

    # Replace entire data table
    tbl_id_pos = modified.find('id="1766376154"')
    tbl_tag_start = modified.rfind('<hp:tbl', 0, tbl_id_pos)

    depth = 0
    i = tbl_tag_start
    tbl_end = -1
    while i < len(modified):
        if modified[i:i+7] == '<hp:tbl':
            depth += 1
        elif modified[i:i+8] == '</hp:tbl':
            depth -= 1
            if depth == 0:
                tbl_end = modified.find('>', i) + 1
                break
        i += 1

    new_table = build_new_table(college_name, rows_data)
    modified = modified[:tbl_tag_start] + new_table + modified[tbl_end:]
    return modified


def main():
    with open(REF_SECTION, 'r', encoding='utf-8') as f:
        template_xml = f.read()

    build_script = os.path.join(SKILL_DIR, "scripts", "build_hwpx.py")
    validate_script = os.path.join(SKILL_DIR, "scripts", "validate.py")

    results = []

    for file_num, college_name, recipient, rows_data in COLLEGES:
        out_name = f"{file_num}. (공문제출)2027학년도 교수초빙 계획·학문분야별 TO 안내 및 초빙 세부내역 제출 요청({college_name}).hwpx"
        out_path = os.path.join(WORK_DIR, out_name)

        new_xml = create_section_xml(template_xml, college_name, recipient, rows_data)

        tmp_section = os.path.join(WORK_DIR, f"_tmp_section_{file_num}.xml")
        with open(tmp_section, 'w', encoding='utf-8') as f:
            f.write(new_xml)

        cmd = [sys.executable, build_script,
               "--header", REF_HEADER,
               "--section", tmp_section,
               "--output", out_path]
        result = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8')

        if result.returncode != 0:
            print(f"[FAIL] {out_name}")
            print(f"  {result.stderr[:200]}")
            results.append((file_num, college_name, "FAIL"))
        else:
            val = subprocess.run([sys.executable, validate_script, out_path],
                                capture_output=True, text=True, encoding='utf-8')
            status = "OK" if val.returncode == 0 else "WARN"
            print(f"[{status}] {out_name} ({len(rows_data)}행)")
            results.append((file_num, college_name, status))

        os.remove(tmp_section)

    ok = sum(1 for _, _, s in results if s == "OK")
    print(f"\n=== 성공: {ok}/{len(results)} ===")


if __name__ == "__main__":
    main()
