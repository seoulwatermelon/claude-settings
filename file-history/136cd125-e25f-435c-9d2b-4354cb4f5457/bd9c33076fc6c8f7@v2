def create_section_xml(xml_text, college_name, recipient, rows_data):
    """Modify section0.xml for a specific college."""
    modified = xml_text

    # 1. Replace 수신자
    modified = modified.replace(
        ">유학대학장(유학/문과대학행정실장)<",
        f">{recipient}<"
    )

    # 2. Replace 제목 (유학대학 → college_name)
    modified = modified.replace(
        "제출 요청(유학대학)<",
        f"제출 요청({college_name})<"
    )

    # 3. Replace the entire data table
    # Find old table
    old_tbl_start_marker = 'id="1766376154"'
    tbl_id_pos = modified.find(old_tbl_start_marker)
    tbl_tag_start = modified.rfind('<hp:tbl', 0, tbl_id_pos)

    # Find end of table (handle nested tables by counting depth)
    depth = 0
    i = tbl_tag_start
    tbl_end = -1
    while i < len(modified):
        if modified[i:i+7] == '<hp:tbl':
            depth += 1
        elif modified[i:i+8] == '</hp:tbl':
            depth -= 1
            if depth == 0:
                tbl_end = modified.find('>', i) + 1
                break
        i += 1

    old_table = modified[tbl_tag_start:tbl_end]
    new_table = build_new_table(college_name, rows_data)

    modified = modified[:tbl_tag_start] + new_table + modified[tbl_end:]

    return modified


def main():
    # Read template section0.xml
    with open(REF_SECTION, 'r', encoding='utf-8') as f:
        template_xml = f.read()

    build_script = os.path.join(SKILL_DIR, "scripts", "build_hwpx.py")
    validate_script = os.path.join(SKILL_DIR, "scripts", "validate.py")

    results = []

    for file_num, college_name, recipient, rows_data in COLLEGES:
        # Output file name
        out_name = f"{file_num}. (공문제출)2027학년도 교수초빙 계획·학문분야별 TO 안내 및 초빙 세부내역 제출 요청({college_name}).hwpx"
        out_path = os.path.join(WORK_DIR, out_name)

        # Create modified section0.xml
        new_xml = create_section_xml(template_xml, college_name, recipient, rows_data)

        # Write temp section file
        tmp_section = os.path.join(WORK_DIR, f"_tmp_section_{file_num}.xml")
        with open(tmp_section, 'w', encoding='utf-8') as f:
            f.write(new_xml)

        # Build HWPX using build_hwpx.py
        cmd = [
            sys.executable, build_script,
            "--header", REF_HEADER,
            "--section", tmp_section,
            "--output", out_path
        ]
        result = subprocess.run(cmd, capture_output=True, text=True, encoding='utf-8')

        if result.returncode != 0:
            print(f"[FAIL] {out_name}")
            print(f"  stderr: {result.stderr[:200]}")
            results.append((file_num, college_name, "FAIL", result.stderr[:100]))
        else:
            # Validate
            val_cmd = [sys.executable, validate_script, out_path]
            val_result = subprocess.run(val_cmd, capture_output=True, text=True, encoding='utf-8')
            if val_result.returncode == 0:
                print(f"[OK] {out_name} ({len(rows_data)}행)")
                results.append((file_num, college_name, "OK", f"{len(rows_data)}행"))
            else:
                print(f"[WARN] {out_name} - validation issue")
                print(f"  {val_result.stdout[:200]}")
                results.append((file_num, college_name, "WARN", val_result.stdout[:100]))

        # Clean up temp file
        os.remove(tmp_section)

    print("\n=== 결과 요약 ===")
    ok_count = sum(1 for _, _, s, _ in results if s == "OK")
    print(f"성공: {ok_count}/{len(results)}")
    for num, name, status, detail in results:
        print(f"  {num}. {name}: {status} ({detail})")


if __name__ == "__main__":
    main()
