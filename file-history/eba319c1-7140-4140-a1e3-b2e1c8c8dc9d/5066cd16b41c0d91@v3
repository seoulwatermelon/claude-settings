vba_lines.append("    Randomize Timer")
vba_lines.append("    For i = UBound(arr) To LBound(arr) + 1 Step -1")
vba_lines.append("        j = Int((i - LBound(arr) + 1) * Rnd) + LBound(arr)")
vba_lines.append("        tmp = arr(i): arr(i) = arr(j): arr(j) = tmp")
vba_lines.append("    Next i")
vba_lines.append("End Sub")
vba_lines.append("")
