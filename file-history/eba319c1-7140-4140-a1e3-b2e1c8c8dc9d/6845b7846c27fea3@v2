highlight_fill = PatternFill(start_color='FFF2CC', end_color='FFF2CC', fill_type='solid')  # 노란색
group_a_fill = PatternFill(start_color='E2EFDA', end_color='E2EFDA', fill_type='solid')  # 초록
group_b_fill = PatternFill(start_color='D6DCE4', end_color='D6DCE4', fill_type='solid')  # 회색
