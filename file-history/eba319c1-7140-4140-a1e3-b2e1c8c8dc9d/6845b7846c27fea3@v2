ws_b.cell(3, 11, '배정순번')
ws_b.cell(3, 12, '건물명')
ws_b.cell(3, 13, '공간명')
ws_b.cell(3, 14, '호실번호')
ws_b.cell(3, 15, '면적(㎡)')
