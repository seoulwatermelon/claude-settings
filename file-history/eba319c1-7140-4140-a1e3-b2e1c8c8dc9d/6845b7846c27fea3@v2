    ws_a.cell(3, ci).alignment = center_align
    ws_a.cell(3, ci).border = border_all

for i, sp in enumerate(dasan_spaces):
    r = 4 + i
    ws_a.cell(r, 11, i + 1)
    ws_a.cell(r, 12, sp['building'])
    ws_a.cell(r, 13, sp['name'])
    ws_a.cell(r, 14, sp['room_no'])
    ws_a.cell(r, 15, sp['area'])
    # 배정 교원: 추첨순위가 i+1인 교원의 이름
    ws_a.cell(r, 16).value = f'=IFERROR(INDEX(B$4:B${3+len(group_a)},MATCH({i+1},H$4:H${3+len(group_a)},0)),"-")'
