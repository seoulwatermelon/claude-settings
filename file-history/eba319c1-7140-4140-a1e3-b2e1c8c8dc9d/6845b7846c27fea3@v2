        ws_a.cell(r, ci).font = body_font
        ws_a.cell(r, ci).alignment = center_align
        ws_a.cell(r, ci).border = border_all
    ws_a.cell(r, 16).fill = result_fill
    ws_a.cell(r, 16).font = Font(name='맑은 고딕', bold=True, size=11)

# 열 너비
for ci, w in enumerate([6, 10, 12, 14, 9, 12, 10, 10, 2, 2, 9, 14, 14, 12, 10, 14], 1):
    ws_a.column_dimensions[get_column_letter(ci)].width = w

# ================================================================
# Sheet 3: 퇴직예정자 공간선택
# ================================================================
ws_sel = wb.create_sheet('퇴직예정자 공간선택')
ws_sel.sheet_properties.tabColor = 'FFC000'

ws_sel.merge_cells('A1:L1')
ws_sel.cell(1, 1, '[B그룹용] 퇴직예정 교원 배정 공간 선택 (8개 선택)').font = subtitle_font
ws_sel.cell(1, 1).fill = PatternFill(start_color='FFF2CC', end_color='FFF2CC', fill_type='solid')
ws_sel.cell(1, 1).alignment = Alignment(horizontal='center', vertical='center')
ws_sel.row_dimensions[1].height = 30

ws_sel.merge_cells('A2:L2')
ws_sel.cell(2, 1, '※ "선택" 열에 O를 입력하여 8개 공간을 지정하세요. 선택된 공간에서 퇴직예정 교원 8명이 랜덤 배정됩니다.').font = Font(name='맑은 고딕', size=10, color='FF0000')

headers_sel = ['No', '선택', '건물명', '층수', '공간명', '호실번호', '면적(㎡)', '화장실', '베란다', '싱크대', '창문', '비고']
for ci, h in enumerate(headers_sel, 1):
    ws_sel.cell(4, ci, h)
style_header(ws_sel, 4, len(headers_sel), fill=PatternFill(start_color='FFC000', end_color='FFC000', fill_type='solid'), font=Font(name='맑은 고딕', bold=True, size=11, color='000000'))

# I-하우스 + 중앙학술정보관 (다산경제관 제외)
non_dasan = [s for s in spaces if '다산' not in str(s['building'])]
for i, sp in enumerate(non_dasan):
    r = 5 + i
    ws_sel.cell(r, 1, sp['no'])
    ws_sel.cell(r, 2, '')  # 선택 열 (사용자가 O 입력)
    ws_sel.cell(r, 3, sp['building'])
    ws_sel.cell(r, 4, sp['floor'])
    ws_sel.cell(r, 5, sp['name'])
    ws_sel.cell(r, 6, sp['room_no'])
    ws_sel.cell(r, 7, sp['area'])
    # temporary 시트에서 추가 정보
    src_row = None
    for sr in range(2, ws_temp.max_row + 1):
        if ws_temp.cell(sr, 5).value == sp['room_no']:
            src_row = sr
            break
    if src_row:
        ws_sel.cell(r, 8, ws_temp.cell(src_row, 7).value or '')
        ws_sel.cell(r, 9, ws_temp.cell(src_row, 8).value or '')
        ws_sel.cell(r, 10, ws_temp.cell(src_row, 9).value or '')
        ws_sel.cell(r, 11, ws_temp.cell(src_row, 10).value or '')
    ws_sel.cell(r, 12, sp['note'])
