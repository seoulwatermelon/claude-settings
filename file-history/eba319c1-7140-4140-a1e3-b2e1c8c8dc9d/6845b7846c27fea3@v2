select_fill = PatternFill(start_color='FCE4EC', end_color='FCE4EC', fill_type='solid')    # 핑크
result_fill = PatternFill(start_color='E8F5E9', end_color='E8F5E9', fill_type='solid')    # 연초록
center_align = Alignment(horizontal='center', vertical='center', wrap_text=True)
left_align = Alignment(horizontal='left', vertical='center', wrap_text=True)

def style_header(ws, row, max_col, font=header_font, fill=header_fill):
    for col in range(1, max_col + 1):
        cell = ws.cell(row, col)
        cell.font = font
        cell.fill = fill
        cell.alignment = center_align
        cell.border = border_all

def style_body(ws, row, max_col, fill=None):
    for col in range(1, max_col + 1):
        cell = ws.cell(row, col)
        cell.font = body_font
        cell.alignment = center_align
        cell.border = border_all
        if fill:
            cell.fill = fill

# ─── 원본 데이터 로드 ───
wb_src = openpyxl.load_workbook(SRC, data_only=True)
ws_data = wb_src['data']
ws_temp = wb_src['temporary']

# 이전 대상자 (성별 남/여)
movers = []
for row in range(2, ws_data.max_row + 1):
    gender = ws_data.cell(row, 14).value  # N열
    if gender and str(gender).strip() in ('남', '여'):
        retire_raw = ws_data.cell(row, 13).value
        retire_str = str(retire_raw) if retire_raw else ''
        retire_year = None
        try:
            if isinstance(retire_raw, datetime):
                retire_year = retire_raw.year
            elif '(' in retire_str:
                retire_year = int(retire_str.split('(')[1].split('.')[0])
            elif '-' in retire_str:
                retire_year = int(retire_str[:4])
        except:
            pass

        movers.append({
            'name': ws_data.cell(row, 9).value,
            'college': ws_data.cell(row, 10).value,
            'major': ws_data.cell(row, 11).value,
            'room': ws_data.cell(row, 4).value,
            'retire': retire_str[:10],
            'retire_year': retire_year,
            'gender': str(gender).strip(),
        })

# 임시공간 목록
spaces = []
for row in range(2, ws_temp.max_row + 1):
    spaces.append({
        'no': ws_temp.cell(row, 1).value,
        'building': ws_temp.cell(row, 2).value,
        'floor': ws_temp.cell(row, 3).value,
        'name': ws_temp.cell(row, 4).value,
        'room_no': ws_temp.cell(row, 5).value,
        'area': ws_temp.cell(row, 6).value,
        'note': ws_temp.cell(row, 11).value or '',
    })

# 그룹 분류
