        c.font = Font(name='맑은 고딕', size=10)

ws1.column_dimensions['A'].width = 100

# ================================================================
# Sheet 2: A그룹_경제대학 (5명 → 다산경제관 7개)
# ================================================================
ws_a = wb.create_sheet('A그룹_경제대학')
ws_a.sheet_properties.tabColor = '70AD47'

ws_a.merge_cells('A1:J1')
ws_a.cell(1, 1, '[A그룹] 경제대학 교원 → 다산경제관 랜덤 배정').font = subtitle_font
ws_a.cell(1, 1).fill = group_a_fill
