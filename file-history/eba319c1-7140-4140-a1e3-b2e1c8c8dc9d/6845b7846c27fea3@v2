    ws_c.cell(4, ci).border = border_all

# 잔여 공간: 선택 시트에서 "O"가 아닌 공간들
# SMALL+IF 배열수식으로 선택 안 된 공간 참조
remaining_count = len(non_dasan) - 8  # 87 - 8 = 79
for i in range(remaining_count):
    r = 5 + i
    ws_c.cell(r, 11, i + 1)

    sel_range_b = f"'{sel_sheet}'!B$5:B${4+len(non_dasan)}"
    sel_range_c = f"'{sel_sheet}'!C$5:C${4+len(non_dasan)}"
    sel_range_e = f"'{sel_sheet}'!E$5:E${4+len(non_dasan)}"
    sel_range_f = f"'{sel_sheet}'!F$5:F${4+len(non_dasan)}"
    sel_range_g = f"'{sel_sheet}'!G$5:G${4+len(non_dasan)}"

    # 건물명 (선택 안 된 것 중 i+1번째)
    ws_c.cell(r, 12).value = f'=IFERROR(INDEX({sel_range_c},SMALL(IF({sel_range_b}<>"O",ROW({sel_range_b})-ROW(INDEX({sel_range_b},1))+1),{i+1})),"")'
    ws_c.cell(r, 13).value = f'=IFERROR(INDEX({sel_range_e},SMALL(IF({sel_range_b}<>"O",ROW({sel_range_b})-ROW(INDEX({sel_range_b},1))+1),{i+1})),"")'
    ws_c.cell(r, 14).value = f'=IFERROR(INDEX({sel_range_f},SMALL(IF({sel_range_b}<>"O",ROW({sel_range_b})-ROW(INDEX({sel_range_b},1))+1),{i+1})),"")'
    ws_c.cell(r, 15).value = f'=IFERROR(INDEX({sel_range_g},SMALL(IF({sel_range_b}<>"O",ROW({sel_range_b})-ROW(INDEX({sel_range_b},1))+1),{i+1})),"")'
    # 배정 교원
    ws_c.cell(r, 16).value = f'=IFERROR(INDEX(B$5:B${4+len(group_c)},MATCH({i+1},H$5:H${4+len(group_c)},0)),"-")'

    for ci in range(11, 17):
        ws_c.cell(r, ci).font = body_font
        ws_c.cell(r, ci).alignment = center_align
        ws_c.cell(r, ci).border = border_all
    ws_c.cell(r, 16).fill = result_fill
    ws_c.cell(r, 16).font = Font(name='맑은 고딕', bold=True, size=11)

for ci, w in enumerate([6, 10, 14, 14, 9, 12, 10, 10, 2, 2, 9, 18, 18, 12, 10, 14], 1):
