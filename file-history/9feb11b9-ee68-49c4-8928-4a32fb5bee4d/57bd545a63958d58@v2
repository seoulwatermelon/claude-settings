import Link from "next/link";
import { Download } from "lucide-react";
import { requireUser } from "@/lib/auth";
import { getCandidateManagementRows, getRecruitmentRequestOptionsForDepartment } from "@/lib/queries";
import { CandidateManagementTable } from "@/components/candidate-management-table";
import { RollingRequestForm } from "@/components/rolling-request-form";

export default async function CandidatesPage() {
  const currentUser = await requireUser();
  const rows = getCandidateManagementRows(currentUser);
  const requestOptions =
    currentUser.role === "DEAN" && currentUser.departmentCode
      ? getRecruitmentRequestOptionsForDepartment(currentUser.departmentCode, currentUser)
      : [];

  return (
    <div>
      <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: 20 }}>
        <div>
          <h2 style={{ fontSize: 18, fontWeight: 600, color: "var(--text-title)", margin: 0 }}>후보자 관리</h2>
          <p style={{ fontSize: 12, color: "var(--text-secondary)", margin: "2px 0 0" }}>
            후보자별 소속, 직위, 학위, 연구분야, 메모와 CV 자료를 관리합니다
          </p>
        </div>
        <Link
          href="/api/candidates/export"
          className="btn-primary"
          style={{ display: "inline-flex", alignItems: "center", gap: 6, textDecoration: "none" }}
        >
          <Download className="h-4 w-4" />
          Excel 내보내기
        </Link>
      </div>

      {currentUser.role === "DEAN" && currentUser.departmentCode ? (
        <div style={{ marginBottom: 20 }}>
          <RollingRequestForm deptCode={currentUser.departmentCode} requestOptions={requestOptions} />
        </div>
      ) : null}

      <div className="card" style={{ padding: 0, overflow: "visible" }}>
        <CandidateManagementTable initialRows={rows} />
      </div>
    </div>
  );
}
