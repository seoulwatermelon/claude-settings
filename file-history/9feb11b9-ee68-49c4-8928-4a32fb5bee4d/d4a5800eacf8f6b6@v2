- [ ] **Step 1: lib/review-decisions.ts 작성**

```typescript
// lib/review-decisions.ts
import { getDb } from "./db";

export type ReviewDecision = {
  id: number;
  requestId: number;
  candidateId: number;
  stepKey: string;
  reviewerId: number;
  decision: string | null;
  comment: string | null;
  reviewDataJson: string;
  createdAt: string;
  updatedAt: string;
};

type ReviewRow = {
  id: number;
  request_id: number;
  candidate_id: number;
  step_key: string;
  reviewer_id: number;
  decision: string | null;
  comment: string | null;
  review_data_json: string;
  created_at: string;
  updated_at: string;
};

function mapRow(row: ReviewRow): ReviewDecision {
  return {
    id: row.id,
    requestId: row.request_id,
    candidateId: row.candidate_id,
    stepKey: row.step_key,
    reviewerId: row.reviewer_id,
    decision: row.decision,
    comment: row.comment,
    reviewDataJson: row.review_data_json,
    createdAt: row.created_at,
    updatedAt: row.updated_at,
  };
}

export function getReviewDecisions(requestId: number, stepKey?: string): ReviewDecision[] {
  const db = getDb();
  if (stepKey) {
    return (db.prepare(
      "SELECT * FROM review_decisions WHERE request_id = ? AND step_key = ? ORDER BY created_at"
    ).all(requestId, stepKey) as ReviewRow[]).map(mapRow);
  }
  return (db.prepare(
    "SELECT * FROM review_decisions WHERE request_id = ? ORDER BY created_at"
  ).all(requestId) as ReviewRow[]).map(mapRow);
}

export function createReviewDecision(data: {
  requestId: number;
  candidateId: number;
  stepKey: string;
  reviewerId: number;
  decision?: string;
  comment?: string;
  reviewDataJson?: string;
}): ReviewDecision {
  const db = getDb();
  const result = db.prepare(`
    INSERT INTO review_decisions (request_id, candidate_id, step_key, reviewer_id, decision, comment, review_data_json)
    VALUES (?, ?, ?, ?, ?, ?, ?)
    ON CONFLICT(request_id, candidate_id, step_key, reviewer_id)
    DO UPDATE SET decision = excluded.decision, comment = excluded.comment,
      review_data_json = excluded.review_data_json, updated_at = CURRENT_TIMESTAMP
  `).run(
    data.requestId, data.candidateId, data.stepKey, data.reviewerId,
    data.decision || null, data.comment || null, data.reviewDataJson || "{}"
  );
  return getReviewDecisionById(Number(result.lastInsertRowid))!;
}

export function updateReviewDecision(id: number, data: {
  decision?: string;
  comment?: string;
  reviewDataJson?: string;
}): ReviewDecision | null {
  const db = getDb();
  db.prepare(`
    UPDATE review_decisions SET
      decision = COALESCE(?, decision),
      comment = COALESCE(?, comment),
      review_data_json = COALESCE(?, review_data_json),
      updated_at = CURRENT_TIMESTAMP
    WHERE id = ?
  `).run(data.decision || null, data.comment || null, data.reviewDataJson || null, id);
  return getReviewDecisionById(id);
}

export function getReviewDecisionById(id: number): ReviewDecision | null {
  const db = getDb();
  const row = db.prepare("SELECT * FROM review_decisions WHERE id = ?").get(id) as ReviewRow | undefined;
  return row ? mapRow(row) : null;
}

export function allCandidatesReviewed(requestId: number, stepKey: string): boolean {
  const db = getDb();
  const candidateCount = db.prepare(
    "SELECT COUNT(*) as c FROM candidate_profiles WHERE request_id = ?"
  ).get(requestId) as { c: number };
  const reviewedCount = db.prepare(
    "SELECT COUNT(*) as c FROM review_decisions WHERE request_id = ? AND step_key = ? AND decision IS NOT NULL"
  ).get(requestId, stepKey) as { c: number };
  return candidateCount.c > 0 && reviewedCount.c >= candidateCount.c;
}
```

