```typescript
// app/api/workflow/advance/route.ts
import { NextRequest, NextResponse } from "next/server";
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { allCandidatesReviewed } from "@/lib/review-decisions";
import { getDb } from "@/lib/db";
import { getNextStatus, getProcedureType, PROCEDURE_STEPS } from "@/lib/constants";

export async function POST(req: NextRequest) {
  const user = await requireUser();
  if (!checkPermission(user.role, "workflow.advance", "edit")) {
    return NextResponse.json({ error: "FORBIDDEN" }, { status: 403 });
  }

  const { requestId } = await req.json();
  const db = getDb();
  const request = db.prepare("SELECT * FROM recruitment_requests WHERE id = ?").get(requestId) as any;
  if (!request) return NextResponse.json({ error: "Request not found" }, { status: 404 });

  const currentStatus = request.status;
  const procedureType = getProcedureType(request.hiring_type);
  const nextStatus = getNextStatus(procedureType, currentStatus);

  if (!nextStatus) {
    return NextResponse.json({ error: "이미 마지막 단계입니다" }, { status: 400 });
  }

  // 현재 단계에서 모든 후보자 심사 완료 확인
  const currentStepKey = PROCEDURE_STEPS[procedureType]?.find(s => s.title === currentStatus)?.stepKey;
  if (currentStepKey && !allCandidatesReviewed(requestId, currentStepKey)) {
    return NextResponse.json({ error: "모든 후보자 심사를 완료해주세요" }, { status: 400 });
  }

  db.prepare("UPDATE recruitment_requests SET status = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?")
    .run(nextStatus, requestId);

  return NextResponse.json({ success: true, newStatus: nextStatus });
}
```

