// app/api/review-decisions/route.ts
import { NextRequest, NextResponse } from "next/server";
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { getReviewDecisions, createReviewDecision } from "@/lib/review-decisions";

export async function GET(req: NextRequest) {
  const user = await requireUser();
  const requestId = Number(req.nextUrl.searchParams.get("requestId"));
  const stepKey = req.nextUrl.searchParams.get("stepKey") || undefined;
  if (!requestId) return NextResponse.json({ error: "requestId required" }, { status: 400 });
  const decisions = getReviewDecisions(requestId, stepKey);
  return NextResponse.json(decisions);
}

export async function POST(req: NextRequest) {
  const user = await requireUser();
  if (!checkPermission(user.role, "workflow.review", "edit")) {
    return NextResponse.json({ error: "FORBIDDEN" }, { status: 403 });
  }
  const body = await req.json();
  const decision = createReviewDecision({ ...body, reviewerId: user.id });
  return NextResponse.json(decision);
}
