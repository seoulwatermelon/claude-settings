- [ ] **Step 2: dashboard 서버 페이지 작성**

```tsx
// app/dashboard/page.tsx
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { redirect } from "next/navigation";
import { getDashboardColumns, getDashboardRows, getDashboardDetail, listUsers, getDepartmentOptions } from "@/lib/queries";
import DashboardTabs from "@/components/dashboard-tabs";

export default async function DashboardPage() {
  const user = await requireUser();
  if (!checkPermission(user.role, "dashboard", "view")) {
    redirect("/login");
  }

  const columns = getDashboardColumns();
  const rows = getDashboardRows(user);
  const initialDetail = rows[0] ? getDashboardDetail(rows[0].id, user) : null;
  const users = (user.role === "VIP" || user.role === "ADMIN") ? listUsers() : [];
  const departments = (user.role === "VIP" || user.role === "ADMIN") ? getDepartmentOptions() : [];

  // KPI 계산
  const requestRows = rows.filter((r) => {
    const raw = JSON.parse(r.rawJson || "{}");
    return raw.requestId != null;
  });
  const total = requestRows.length;
  const completed = requestRows.filter((r) => {
    const vals = r.values || {};
    const step = vals["현재단계"] as string || "";
    return step.includes("완료");
  }).length;
  const waiting = requestRows.filter((r) => {
    const vals = r.values || {};
    const step = vals["현재단계"] as string || "";
    return !step || step === "";
  }).length;
  const inProgress = total - completed - waiting;
  const kpi = { total, inProgress, completed, waiting };

  // 최근 활동
  const recentActivity = requestRows.slice(0, 5).map((r, i) => {
    const vals = r.values || {};
    return {
      id: r.id,
      deptName: r.deptName || "",
      description: `${vals["초빙분야"] || "채용"} ${vals["현재단계"] || "진행중"}`,
      status: (String(vals["현재단계"] || "").includes("완료") ? "complete" : vals["현재단계"] ? "progress" : "waiting") as "complete" | "progress" | "waiting",
      timeAgo: `${i + 1}일 전`,
    };
  });

  return (
    <div>
      <div style={{ marginBottom: 20 }}>
        <h2 style={{ fontSize: 18, fontWeight: 600, color: "#111", margin: 0 }}>채용현황</h2>
        <p style={{ fontSize: 12, color: "#888", margin: "2px 0 0" }}>채용 요약, TO 배분, 진행 현황을 한눈에 확인합니다</p>
      </div>
      <DashboardTabs
        kpi={kpi}
        recentActivity={recentActivity}
        columns={columns}
        rows={rows}
        initialDetail={initialDetail}
        currentUser={user}
        users={users}
        departments={departments}
      />
    </div>
  );
}
```

