    <div style={{ position: "relative", borderTop: "1px solid rgba(255,255,255,0.08)" }}>
      {/* Popup */}
      {open && (
        <div
          style={{
            position: "absolute",
            bottom: "100%",
            left: 8,
            right: 8,
            background: "#142e20",
            borderRadius: 8,
            padding: "8px 0",
            marginBottom: 4,
            boxShadow: "0 -4px 16px rgba(0,0,0,0.3)",
