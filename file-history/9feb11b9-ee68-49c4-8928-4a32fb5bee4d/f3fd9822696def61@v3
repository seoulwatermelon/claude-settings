import Link from "next/link";
import { ArrowLeft } from "lucide-react";
import { ProcedureDetailShell } from "@/components/procedure-detail-shell";
import { requireUser } from "@/lib/auth";
import { getRecruitmentRequestDetail } from "@/lib/queries";

type ProcedurePageProps = {
  params: Promise<{ requestId: string }>;
};

export default async function ProcedurePage({ params }: ProcedurePageProps) {
  const currentUser = await requireUser();
  const { requestId } = await params;
  const detail = getRecruitmentRequestDetail(Number(requestId), currentUser);

  if (!detail) {
    return (
      <div style={{ padding: 20, color: "var(--text-secondary)" }}>
        요청 정보를 찾을 수 없습니다.
      </div>
    );
  }

  return (
    <div>
      <div style={{ marginBottom: 16 }}>
        <Link
          href="/dashboard"
          className="btn-secondary"
          style={{ display: "inline-flex", alignItems: "center", gap: 6, textDecoration: "none", fontSize: 13 }}
        >
          <ArrowLeft className="h-4 w-4" />
          TO 배분표로 돌아가기
        </Link>
      </div>

      <ProcedureDetailShell detail={detail} currentUser={currentUser} />
    </div>
  );
}
