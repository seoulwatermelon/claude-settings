export interface Degree {
  school?: string;
  major?: string;
  degree_year?: number;
  degree_type?: string;
}

export interface Career {
  institution?: string;
  position?: string;
  period?: string;
}

export interface Candidate {
  name: string;
  birth_year?: number;
  current_affiliation?: string;
  current_position?: string;
  major_field?: string;
  total_papers?: number;
  jcr_ratio?: number;
  fwci?: number;
  remarks?: string;
  degrees?: Degree[];
  careers?: Career[];
}

export interface HiringProgress {
  progress_date?: string;
  content?: string;
  person_in_charge?: string;
}

export interface SubmissionInput {
  department_name: string;
  dean_name: string;
  submitted_at: string;
  department_plan?: string;
  candidates: Candidate[];
  hiringProgress: HiringProgress[];
}

export interface SubmissionRow {
  id: number;
  department_name: string;
  dean_name: string;
  submitted_at: string;
  department_plan?: string;
  status: string;
  created_at: string;
  candidate_count?: number;
}

export interface SubmissionDetail extends SubmissionRow {
  candidates: (Candidate & { id: number; degrees: Degree[]; careers: Career[] })[];
  hiringProgress: HiringProgress[];
}

