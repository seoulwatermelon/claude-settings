          marginBottom: 4,
        }}
      >
        소속 학과
      </div>
      <div
        style={{
          fontSize: 12,
          color: "var(--sidebar-text)",
        }}
      >
        {user.departmentCode}
      </div>
    </div>
  );
}

export default function Sidebar({
  user,
  viewableResources,
}: {
  user: AuthUser;
  viewableResources: string[];
}) {
  const pathname = usePathname();
  const baseMenu = getMenuForRole(user.role);
  const menu = filterMenuByResources(baseMenu, viewableResources);

  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [isMobile, setIsMobile] = useState(false);

  useEffect(() => {
    const mq = window.matchMedia("(max-width: 767px)");
    setIsMobile(mq.matches);
    const handler = (e: MediaQueryListEvent) => {
      setIsMobile(e.matches);
      setMobileMenuOpen(false);
    };
    mq.addEventListener("change", handler);
    return () => mq.removeEventListener("change", handler);
  }, []);

  if (isMobile) {
    return (
      <>
        {/* Fixed top bar */}
        <div
          style={{
            position: "fixed",
            top: 0,
            left: 0,
            right: 0,
            height: 48,
            background: "#0a1f14",
            display: "flex",
            alignItems: "center",
            justifyContent: "space-between",
            padding: "0 12px",
            zIndex: 100,
          }}
        >
          <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
            <div
              style={{
                width: 30,
                height: 30,
                borderRadius: "50%",
                background: "rgba(255,255,255,0.85)",
                display: "flex",
                alignItems: "center",
                justifyContent: "center",
              }}
            >
              <Image
                src="/logo_SKKU_colored.png"
                alt="SKKU"
                width={20}
                height={20}
                style={{ objectFit: "contain" }}
                unoptimized
              />
            </div>
            <span style={{ color: "#fff", fontSize: 13, fontWeight: 700 }}>
              성균관대학교
            </span>
          </div>
          <button
            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
            style={{
              background: "transparent",
              border: "none",
              color: "#fff",
              cursor: "pointer",
              padding: 4,
            }}
          >
            {mobileMenuOpen ? <X size={22} /> : <Menu size={22} />}
          </button>
        </div>

        {/* Full-screen overlay menu */}
        {mobileMenuOpen && (
          <div
            style={{
              position: "fixed",
              top: 48,
              left: 0,
              right: 0,
              bottom: 0,
              background: "#0a1f14",
              zIndex: 99,
              display: "flex",
              flexDirection: "column",
              overflowY: "auto",
            }}
          >
            <div style={{ paddingTop: 16 }}>
              <MenuContent
                menu={menu}
                pathname={pathname}
                onItemClick={() => setMobileMenuOpen(false)}
              />
            </div>
            <div style={{ marginTop: "auto" }}>
              <DeanDepartmentInfo user={user} />
              <UserMenu user={user} />
            </div>
          </div>
        )}
      </>
    );
  }

  return (
    <aside
      style={{
        width: 180,
        background: "var(--sidebar-bg)",
        padding: "20px 0",
        flexShrink: 0,
        position: "fixed",
        top: 0,
        left: 0,
        bottom: 0,
        display: "flex",
        flexDirection: "column",
        zIndex: 50,
        overflowY: "auto",
      }}
    >
      {/* Logo + Title */}
      <LogoBlock />

      {/* Menu */}
      <MenuContent menu={menu} pathname={pathname} />

      {/* Dean department info */}
      <DeanDepartmentInfo user={user} />

      {/* User info at bottom */}
      <UserMenu user={user} />
    </aside>
  );
}
