import { NextRequest, NextResponse } from "next/server";
import { requireUser } from "@/lib/auth";
import { checkPermission, deleteRole } from "@/lib/permissions";
import { DEFAULT_ROLES } from "@/lib/types";

export async function DELETE(
  _req: NextRequest,
  { params }: { params: Promise<{ role: string }> }
) {
  const user = await requireUser();
  if (!checkPermission(user.role, "system.permissions", "edit")) {
    return NextResponse.json({ error: "FORBIDDEN" }, { status: 403 });
  }

  const { role } = await params;
  if ((DEFAULT_ROLES as readonly string[]).includes(role)) {
    return NextResponse.json(
      { error: "기본 역할은 삭제할 수 없습니다." },
      { status: 400 }
    );
  }

  const result = deleteRole(role);
  if (!result.success) {
    return NextResponse.json({ error: result.error }, { status: 400 });
  }
  return NextResponse.json({ success: true });
}
