// lib/permissions.ts
import { getDb } from "./db";

export function checkPermission(
  role: string,
  resource: string,
  action: string
): boolean {
  const db = getDb();

  // 먼저 와일드카드 '*' 체크
  const wildcard = db
    .prepare(
      "SELECT allowed FROM permissions WHERE role = ? AND resource = '*' AND action = ? LIMIT 1"
    )
    .get(role, action) as { allowed: number } | undefined;

  if (wildcard) return wildcard.allowed === 1;

  // 정확한 resource 체크
  const exact = db
    .prepare(
      "SELECT allowed FROM permissions WHERE role = ? AND resource = ? AND action = ? LIMIT 1"
    )
    .get(role, resource, action) as { allowed: number } | undefined;

  if (exact) return exact.allowed === 1;

  // 권한 레코드가 없으면 거부
  return false;
}

export function getPermissionsForRole(role: string): {
  resource: string;
  action: string;
  allowed: boolean;
}[] {
  const db = getDb();
  const rows = db
    .prepare("SELECT resource, action, allowed FROM permissions WHERE role = ?")
    .all(role) as { resource: string; action: string; allowed: number }[];
  return rows.map((r) => ({
    resource: r.resource,
    action: r.action,
    allowed: r.allowed === 1,
  }));
}

export function updatePermissions(
  role: string,
  changes: { resource: string; action: string; allowed: boolean }[]
): void {
  const db = getDb();
  const upsert = db.prepare(`
    INSERT INTO permissions (role, resource, action, allowed)
    VALUES (?, ?, ?, ?)
    ON CONFLICT(role, resource, action)
    DO UPDATE SET allowed = excluded.allowed, updated_at = CURRENT_TIMESTAMP
  `);
  const tx = db.transaction(() => {
    for (const c of changes) {
      upsert.run(role, c.resource, c.action, c.allowed ? 1 : 0);
    }
  });
  tx();
}

export function getAllRoles(): string[] {
  const db = getDb();
  const rows = db
    .prepare("SELECT DISTINCT role FROM permissions ORDER BY role")
    .all() as { role: string }[];
  return rows.map((r) => r.role);
}

export function createRole(role: string): void {
  const db = getDb();
  const RESOURCES = [
    "dashboard.summary", "dashboard.allocation", "dashboard.progress",
    "candidates", "procedures", "actions",
    "admin.data-sheet", "admin.workflow",
    "system.permissions", "system.users",
    "etc",
  ];
  const ACTIONS = ["view", "edit", "delete", "export", "import"];
  const insert = db.prepare(
    "INSERT OR IGNORE INTO permissions (role, resource, action, allowed) VALUES (?, ?, ?, 0)"
  );
  const tx = db.transaction(() => {
    for (const resource of RESOURCES) {
      for (const action of ACTIONS) {
        insert.run(role, resource, action);
      }
    }
  });
  tx();
}

export function deleteRole(role: string): { success: boolean; error?: string } {
  const db = getDb();
  const userCount = db
    .prepare("SELECT COUNT(*) as count FROM users WHERE role = ?")
    .get(role) as { count: number };
  if (userCount.count > 0) {
    return { success: false, error: `${userCount.count}명의 사용자가 이 역할을 사용 중입니다.` };
  }
  db.prepare("DELETE FROM permissions WHERE role = ?").run(role);
  return { success: true };
}

export function getViewableResources(role: string): string[] {
  const db = getDb();

  // 와일드카드 체크
  const wildcard = db
    .prepare("SELECT allowed FROM permissions WHERE role = ? AND resource = '*' AND action = 'view'")
    .get(role) as { allowed: number } | undefined;

  if (wildcard?.allowed === 1) {
    const RESOURCES = [
      "dashboard.summary", "dashboard.allocation", "dashboard.progress",
      "candidates", "procedures", "actions",
      "admin.data-sheet", "admin.workflow",
      "system.permissions", "system.users",
    ];
    return RESOURCES;
  }

  const rows = db
    .prepare("SELECT resource FROM permissions WHERE role = ? AND action = 'view' AND allowed = 1")
    .all(role) as { resource: string }[];
  return rows.map((r) => r.resource);
}
