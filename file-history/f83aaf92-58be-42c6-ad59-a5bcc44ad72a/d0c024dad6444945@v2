// app/(admin)/data-sheet/page.tsx
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { redirect } from "next/navigation";
import { getAdminRequestSheet } from "@/lib/queries";
import AdminRequestSheet from "@/components/admin-request-sheet";

export default async function DataSheetPage() {
  const user = await requireUser();
  if (!checkPermission(user.role, "admin.data-sheet", "view")) {
    redirect("/summary");
  }

  const { columns, rows } = getAdminRequestSheet();
  const canEdit = checkPermission(user.role, "admin.data-sheet", "edit");

  return (
    <div>
      <div style={{ marginBottom: 20 }}>
        <h2 style={{ fontSize: 18, fontWeight: 600, color: "var(--text-title)", margin: 0 }}>
          데이터 관리
        </h2>
        <p style={{ fontSize: 12, color: "var(--text-secondary)", margin: "2px 0 0" }}>
          recruitment_requests 테이블 직접 편집
        </p>
      </div>
      <AdminRequestSheet columns={columns} rows={rows} readOnly={!canEdit} />
    </div>
  );
}
```

