- [ ] **Step 2: 마이그레이션 스크립트 작성**

```typescript
// scripts/migrate-permissions.ts
import Database from "better-sqlite3";
import path from "path";

const DB_PATH = path.join(process.cwd(), "data", "recruiting.db");
const db = new Database(DB_PATH);
db.pragma("journal_mode = WAL");
db.pragma("foreign_keys = ON");

// 1. permissions 테이블 생성
db.exec(`
  CREATE TABLE IF NOT EXISTS permissions (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    role TEXT NOT NULL,
    resource TEXT NOT NULL,
    action TEXT NOT NULL,
    allowed INTEGER NOT NULL DEFAULT 0,
    created_at TEXT DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
    UNIQUE(role, resource, action)
  );
`);

// 2. SUPER_ADMIN → VIP 마이그레이션
db.exec(`UPDATE users SET role = 'VIP' WHERE role = 'SUPER_ADMIN';`);

// 3. users 테이블 CHECK 제약 제거
const hasCheck = db
  .prepare("SELECT sql FROM sqlite_master WHERE type='table' AND name='users'")
  .get() as { sql: string } | undefined;

if (hasCheck?.sql?.includes("CHECK")) {
  db.exec(`
    ALTER TABLE users RENAME TO users_old;
    CREATE TABLE users (
      id INTEGER PRIMARY KEY AUTOINCREMENT,
      username TEXT NOT NULL UNIQUE,
      password TEXT NOT NULL,
      role TEXT NOT NULL,
      department_code TEXT,
      created_at TEXT DEFAULT CURRENT_TIMESTAMP,
      updated_at TEXT DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (department_code) REFERENCES departments (dept_code)
    );
    INSERT INTO users SELECT * FROM users_old;
    DROP TABLE users_old;
  `);
}

// 4. 시드 권한 데이터
const RESOURCES = [
  "dashboard.summary", "dashboard.allocation", "dashboard.progress",
  "candidates", "procedures", "actions",
  "admin.data-sheet", "admin.workflow",
  "system.permissions", "system.users",
];
const ACTIONS = ["view", "edit", "delete", "export", "import"];

const insertPerm = db.prepare(
  "INSERT OR IGNORE INTO permissions (role, resource, action, allowed) VALUES (?, ?, ?, ?)"
);

const seedAll = db.transaction(() => {
  // VIP: wildcard 전체 허용
  for (const action of ACTIONS) {
    insertPerm.run("VIP", "*", action, 1);
  }

  // ADMIN 권한
  const adminPerms: Record<string, Record<string, number>> = {
