- [ ] **Step 2: summary 서버 페이지 작성**

```tsx
// app/(dashboard)/summary/page.tsx
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { redirect } from "next/navigation";
import { getDashboardRows } from "@/lib/queries";
import SummaryPage from "@/components/summary-page";

export default async function Summary() {
  const user = await requireUser();
  if (!checkPermission(user.role, "dashboard.summary", "view")) {
    redirect("/");
  }

  const rows = getDashboardRows(user);

  // KPI 계산: rows에서 recruitment_requests의 status 기준으로 집계
  // 실제 구현 시 queries.ts에서 KPI 전용 쿼리 추가 필요
  const total = rows.length;
  const completed = rows.filter((r) => {
    const raw = JSON.parse(r.rawJson || "{}");
    return raw.status === "임용 완료" || raw.status === "임용완료";
  }).length;
  const waiting = rows.filter((r) => {
    const raw = JSON.parse(r.rawJson || "{}");
    return !raw.status || raw.status === "" || raw.status === "대기";
  }).length;
  const inProgress = total - completed - waiting;

  const kpi = { total, inProgress, completed, waiting };

  // 최근 활동: 최근 수정된 rows 기반으로 생성
  const recentActivity = rows.slice(0, 5).map((r, i) => {
    const raw = JSON.parse(r.rawJson || "{}");
    return {
      id: r.id,
      deptName: r.deptName || "",
      description: `${raw.field_name || "채용"} ${raw.status || "진행중"}`,
      status: (raw.status?.includes("완료") ? "complete" : raw.status ? "progress" : "waiting") as
        "complete" | "progress" | "waiting",
      timeAgo: `${i + 1}일 전`,
    };
  });

  return <SummaryPage kpi={kpi} recentActivity={recentActivity} />;
}
```

