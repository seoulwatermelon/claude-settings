// app/(system)/users/page.tsx
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import { redirect } from "next/navigation";
import { listUsers, getDepartmentOptions } from "@/lib/queries";
import UserAdminPanel from "@/components/user-admin-panel";

export default async function UsersPage() {
  const user = await requireUser();
  if (!checkPermission(user.role, "system.users", "view")) {
    redirect("/summary");
  }

  const users = listUsers();
  const departments = getDepartmentOptions();
  const canEdit = checkPermission(user.role, "system.users", "edit");

  return (
    <div>
      <div style={{ marginBottom: 20 }}>
        <h2 style={{ fontSize: 18, fontWeight: 600, color: "var(--text-title)", margin: 0 }}>
          사용자 관리
        </h2>
        <p style={{ fontSize: 12, color: "var(--text-secondary)", margin: "2px 0 0" }}>
          시스템 사용자 계정을 관리합니다
        </p>
      </div>
      <UserAdminPanel users={users} departments={departments} readOnly={!canEdit} />
    </div>
  );
}
```

