// app/api/permissions/route.ts
import { NextRequest, NextResponse } from "next/server";
import { requireUser } from "@/lib/auth";
import { checkPermission } from "@/lib/permissions";
import {
  getPermissionsForRole,
  updatePermissions,
  getAllRoles,
} from "@/lib/permissions";

export async function GET() {
  const user = await requireUser();
  if (!checkPermission(user.role, "system.permissions", "view")) {
    return NextResponse.json({ error: "FORBIDDEN" }, { status: 403 });
  }

  const roles = getAllRoles();
  const result: Record<string, { resource: string; action: string; allowed: boolean }[]> = {};
  for (const role of roles) {
    result[role] = getPermissionsForRole(role);
  }
  return NextResponse.json({ roles, permissions: result });
}

export async function PATCH(req: NextRequest) {
  const user = await requireUser();
  if (!checkPermission(user.role, "system.permissions", "edit")) {
    return NextResponse.json({ error: "FORBIDDEN" }, { status: 403 });
  }

  const body = await req.json();
  const { role, changes } = body as {
    role: string;
    changes: { resource: string; action: string; allowed: boolean }[];
  };

  updatePermissions(role, changes);
  return NextResponse.json({ success: true });
}
