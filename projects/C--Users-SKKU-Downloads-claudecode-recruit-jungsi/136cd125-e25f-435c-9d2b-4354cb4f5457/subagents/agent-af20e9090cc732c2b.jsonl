{"parentUuid":"26d8f99b-57f5-4988-9c54-01722a7ee445","isSidechain":true,"agentId":"af20e9090cc732c2b","message":{"model":"claude-sonnet-4-6","id":"msg_015iSdmfKYvKNxy82kpKiNs5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017Ej66xADuBQ6mR6rssXv9e","name":"Write","input":{"file_path":"C:\\Users\\SKKU\\Downloads\\claudecode\\recruit_jungsi\\create_2027_hwpx.py","content":"#!/usr/bin/env python\n# -*- coding: utf-8 -*-\n\"\"\"\nCreate 17 HWPX files for 2027학년도 교수초빙 공문 (각 대학별)\n\"\"\"\n\nimport zipfile\nimport os\nimport re\nimport shutil\n\nWORKDIR = r\"C:\\Users\\SKKU\\Downloads\\claudecode\\recruit_jungsi\"\nTEMPLATE = os.path.join(WORKDIR, \"3. (공문제출)2026학년도 교수초빙 계획·학문분야별 TO 안내 및 초빙 세부내역 제출 요청(유학대학).hwpx\")\n\n# Template data row (from actual XML analysis)\n# We'll build each row using this structure, substituting values\nTEMPLATE_DATA_ROW = (\n    '<hp:tr>'\n    '<hp:tc name=\"\" header=\"0\" hasMargin=\"0\" protect=\"0\" editable=\"0\" dirty=\"0\" borderFillIDRef=\"14\">'\n    '<hp:subList id=\"\" textDirection=\"HORIZONTAL\" lineWrap=\"BREAK\" vertAlign=\"CENTER\" linkListIDRef=\"0\" linkListNextIDRef=\"0\" textWidth=\"0\" textHeight=\"0\" hasTextRef=\"0\" hasNumRef=\"0\">'\n    '<hp:p id=\"2147483648\" paraPrIDRef=\"29\" styleIDRef=\"0\" pageBreak=\"0\" columnBreak=\"0\" merged=\"0\">'\n    '<hp:run charPrIDRef=\"26\"><hp:t>{college}</hp:t></hp:run>'\n    '<hp:linesegarray><hp:lineseg textpos=\"0\" vertpos=\"0\" vertsize=\"1100\" textheight=\"1100\" baseline=\"935\" spacing=\"332\" horzpos=\"0\" horzsize=\"7228\" flags=\"393216\"/></hp:linesegarray>'\n    '</hp:p></hp:subList>'\n    '<hp:cellAddr colAddr=\"0\" rowAddr=\"{row}\"/><hp:cellSpan colSpan=\"1\" rowSpan=\"1\"/><hp:cellSz width=\"7504\" height=\"3199\"/><hp:cellMargin left=\"0\" right=\"0\" top=\"0\" bottom=\"0\"/>'\n    '</hp:tc>'\n    '<hp:tc name=\"\" header=\"0\" hasMargin=\"0\" protect=\"0\" editable=\"0\" dirty=\"0\" borderFillIDRef=\"15\">'\n    '<hp:subList id=\"\" textDirection=\"HORIZONTAL\" lineWrap=\"BREAK\" vertAlign=\"CENTER\" linkListIDRef=\"0\" linkListNextIDRef=\"0\" textWidth=\"0\" textHeight=\"0\" hasTextRef=\"0\" hasNumRef=\"0\">'\n    '<hp:p id=\"2147483648\" paraPrIDRef=\"30\" styleIDRef=\"0\" pageBreak=\"0\" columnBreak=\"0\" merged=\"0\">'\n    '<hp:run charPrIDRef=\"26\"><hp:t>{dept}</hp:t></hp:run>'\n    '<hp:linesegarray><hp:lineseg textpos=\"0\" vertpos=\"0\" vertsize=\"1100\" textheight=\"1100\" baseline=\"935\" spacing=\"332\" horzpos=\"0\" horzsize=\"9496\" flags=\"393216\"/></hp:linesegarray>'\n    '</hp:p></hp:subList>'\n    '<hp:cellAddr colAddr=\"1\" rowAddr=\"{row}\"/><hp:cellSpan colSpan=\"1\" rowSpan=\"1\"/><hp:cellSz width=\"9772\" height=\"3199\"/><hp:cellMargin left=\"0\" right=\"0\" top=\"0\" bottom=\"0\"/>'\n    '</hp:tc>'\n    '<hp:tc name=\"\" header=\"0\" hasMargin=\"0\" protect=\"0\" editable=\"0\" dirty=\"0\" borderFillIDRef=\"15\">'\n    '<hp:subList id=\"\" textDirection=\"HORIZONTAL\" lineWrap=\"BREAK\" vertAlign=\"CENTER\" linkListIDRef=\"0\" linkListNextIDRef=\"0\" textWidth=\"0\" textHeight=\"0\" hasTextRef=\"0\" hasNumRef=\"0\">'\n    '<hp:p id=\"2147483648\" paraPrIDRef=\"23\" styleIDRef=\"0\" pageBreak=\"0\" columnBreak=\"0\" merged=\"0\">'\n    '<hp:run charPrIDRef=\"26\"><hp:t>1</hp:t></hp:run>'\n    '<hp:linesegarray><hp:lineseg textpos=\"0\" vertpos=\"0\" vertsize=\"1100\" textheight=\"1100\" baseline=\"935\" spacing=\"332\" horzpos=\"0\" horzsize=\"4400\" flags=\"393216\"/></hp:linesegarray>'\n    '</hp:p></hp:subList>'\n    '<hp:cellAddr colAddr=\"2\" rowAddr=\"{row}\"/><hp:cellSpan colSpan=\"1\" rowSpan=\"1\"/><hp:cellSz width=\"4679\" height=\"3199\"/><hp:cellMargin left=\"0\" right=\"0\" top=\"0\" bottom=\"0\"/>'\n    '</hp:tc>'\n    '<hp:tc name=\"\" header=\"0\" hasMargin=\"0\" protect=\"0\" editable=\"0\" dirty=\"0\" borderFillIDRef=\"15\">'\n    '<hp:subList id=\"\" textDirection=\"HORIZONTAL\" lineWrap=\"BREAK\" vertAlign=\"CENTER\" linkListIDRef=\"0\" linkListNextIDRef=\"0\" textWidth=\"0\" textHeight=\"0\" hasTextRef=\"0\" hasNumRef=\"0\">'\n    '<hp:p id=\"2147483648\" paraPrIDRef=\"24\" styleIDRef=\"0\" pageBreak=\"0\" columnBreak=\"0\" merged=\"0\">'\n    '<hp:run charPrIDRef=\"27\"><hp:t>{field}</hp:t></hp:run>'\n    '<hp:linesegarray><hp:lineseg textpos=\"0\" vertpos=\"0\" vertsize=\"1100\" textheight=\"1100\" baseline=\"935\" spacing=\"332\" horzpos=\"0\" horzsize=\"16432\" flags=\"393216\"/></hp:linesegarray>'\n    '</hp:p></hp:subList>'\n    '<hp:cellAddr colAddr=\"3\" rowAddr=\"{row}\"/><hp:cellSpan colSpan=\"1\" rowSpan=\"1\"/><hp:cellSz width=\"16708\" height=\"3199\"/><hp:cellMargin left=\"0\" right=\"0\" top=\"0\" bottom=\"0\"/>'\n    '</hp:tc>'\n    '<hp:tc name=\"\" header=\"0\" hasMargin=\"0\" protect=\"0\" editable=\"0\" dirty=\"0\" borderFillIDRef=\"17\">'\n    '<hp:subList id=\"\" textDirection=\"HORIZONTAL\" lineWrap=\"BREAK\" vertAlign=\"CENTER\" linkListIDRef=\"0\" linkListNextIDRef=\"0\" textWidth=\"0\" textHeight=\"0\" hasTextRef=\"0\" hasNumRef=\"0\">'\n    '<hp:p id=\"2147483648\" paraPrIDRef=\"24\" styleIDRef=\"0\" pageBreak=\"0\" columnBreak=\"0\" merged=\"0\">'\n    '<hp:run charPrIDRef=\"28\"/>'\n    '<hp:linesegarray><hp:lineseg textpos=\"0\" vertpos=\"0\" vertsize=\"1000\" textheight=\"1000\" baseline=\"850\" spacing=\"300\" horzpos=\"0\" horzsize=\"9080\" flags=\"393216\"/></hp:linesegarray>'\n    '</hp:p></hp:subList>'\n    '<hp:cellAddr colAddr=\"4\" rowAddr=\"{row}\"/><hp:cellSpan colSpan=\"1\" rowSpan=\"1\"/><hp:cellSz width=\"9359\" height=\"3199\"/><hp:cellMargin left=\"0\" right=\"0\" top=\"0\" bottom=\"0\"/>'\n    '</hp:tc>'\n    '</hp:tr>'\n)\n\ndef build_data_rows(rows):\n    \"\"\"Build XML for N data rows. Each row is (college, dept, field).\"\"\"\n    result = []\n    for i, (college, dept, field) in enumerate(rows):\n        row_xml = TEMPLATE_DATA_ROW.format(\n            college=college,\n            dept=dept,\n            field=field,\n            row=i + 1  # rowAddr starts at 1 for data rows (0 is header)\n        )\n        result.append(row_xml)\n    return ''.join(result)\n\ndef find_old_data_rows_xml(content):\n    \"\"\"Find the template's single data row in the table and return start/end positions.\"\"\"\n    # The data rows start after the header row </hp:tr> and end before </hp:tbl>\n    tbl_start = content.find('id=\"1766376154\"')\n    tbl_end = content.find('</hp:tbl>', tbl_start) + len('</hp:tbl>')\n\n    # Find header row end\n    # The header row has header=\"1\" cells; data row has header=\"0\"\n    # Find the first <hp:tr> with header=\"0\" cell\n    # After the header row closes, data rows begin\n\n    # Find the end of the first hp:tr (header row)\n    first_tr_start = content.find('<hp:tr>', tbl_start)\n    first_tr_end = content.find('</hp:tr>', first_tr_start) + len('</hp:tr>')\n\n    # Data rows are from first_tr_end to </hp:tbl> start\n    data_rows_start = first_tr_end\n    data_rows_end = content.find('</hp:tbl>', tbl_start)\n\n    return data_rows_start, data_rows_end\n\ndef update_row_cnt(content, new_count):\n    \"\"\"Update rowCnt attribute in the table definition.\"\"\"\n    # rowCnt=\"2\" means 1 header + 1 data row\n    # new_count = 1 + N\n    content = re.sub(\n        r'(id=\"1766376154\"[^>]*rowCnt=\")(\\d+)(\")',\n        lambda m: m.group(1) + str(new_count) + m.group(3),\n        content\n    )\n    return content\n\ndef process_college(template_content, college_name_in_title, recipient, rows_data, output_filename):\n    \"\"\"Process and create one college's HWPX file.\"\"\"\n    content = template_content\n\n    # --- Global text replacements ---\n    # 1. Year: 2026학년도 → 2027학년도\n    content = content.replace('2026학년도', '2027학년도')\n\n    # 2. Related document dates\n    content = content.replace(\n        '2025학년도 제2차 교무위원회(2025.03.17.), 교원인사팀-272(2025.03.18.)',\n        '2026학년도 제2차 교무위원회(2026.03.17.), 교원인사팀-272(2026.03.18.)'\n    )\n\n    # 3. Submission deadline\n    content = content.replace('2025. 3. 28.(금) 限', '2026. 3. 27.(금) 限')\n\n    # 4. Announcement date\n    content = content.replace('3. 31.(월)', '3. 30.(월)')\n\n    # --- Replace 수신자 ---\n    content = content.replace(\n        '유학대학장(유학/문과대학행정실장)',\n        recipient\n    )\n\n    # --- Replace 제목 ---\n    # The 제목 now has \"2027학년도\" already (due to replacement above)\n    # Just need to replace (유학대학) → (college_name_in_title)\n    content = content.replace(\n        '요청(유학대학)',\n        f'요청({college_name_in_title})'\n    )\n\n    # --- Rebuild table data rows ---\n    data_start, data_end = find_old_data_rows_xml(content)\n    new_rows_xml = build_data_rows(rows_data)\n    content = content[:data_start] + new_rows_xml + content[data_end:]\n\n    # --- Update rowCnt ---\n    new_row_cnt = 1 + len(rows_data)  # header row + data rows\n    content = update_row_cnt(content, new_row_cnt)\n\n    return content\n\n\n# Define all colleges data\nCOLLEGES = [\n    {\n        \"file_num\": 4,\n        \"name\": \"문과대학\",\n        \"recipient\": \"문과대학장(유학/문과대학행정실장)\",\n        \"output\": \"4. (공문제출)2027학년도 교수초빙 계획·학문분야별 TO 안내 및 초빙 세부내역 제출 요청(문과대학).hwpx\",\n        \"rows\": [\n            (\"문과대학\", \"국어국문학과\", \"▸디지털인문학(한국현대문학)-定\"),\n            (\"문과대학\", \"중어중문학과\", \"▸응용언어학-常\"),\n            (\"문과대학\", \"문헌정보학과\", \"▸Responsible AI &amp; Social Informatics-定\"),\n            (\"문과대학\", \"문헌정보학과\", \"▸Data Analytics &amp; Visualization-常\"),\n        ]\n    },\n    {\n        \"file_num\": 5,\n        \"name\": \"법학전문대학원\",\n        \"recipient\": \"법학전문대학원장(법학행정실장)\",\n        \"output\": \"5. (공문제출)2027학년도 교수초빙 계획·학문분야별 TO 안내 및 초빙 세부내역 제출 요청(법학전문대학원).hwpx\",\n        \"rows\": [\n            (\"법학전문대학원\", \"법학전문대학원\", \"▸형사법-常\"),\n            (\"법학전문대학원\", \"과학수사학과\", \"▸법안전(안전사고/화재 관련)-常\"),\n            (\"법학전문대학원\", \"과학수사학과\", \"▸침해사고 포렌식(해킹, 개인정보유출 등)-常\"),\n        ]\n    },\n    {\n        \"file_num\": 6,\n        \"name\": \"사회과학대학\",\n        \"recipient\": \"사회과학대학장(사회과학대